{
  "name": "double-take-frames-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-cloudflare.mjs",
    "release:stamp-3mf": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stamp-3mf-release.ps1",
    "release:sync": "node scripts/release-artifacts.mjs sync",
    "release:check": "node scripts/release-artifacts.mjs check",
    "release:prepare": "npm run release:stamp-3mf && npm run release:sync && npm run release:check",
    "cad:sync": "npm run release:prepare",
    "cad:check": "npm run release:check",
    "state:check": "node scripts/project-state-check.mjs",
    "workspace:check": "node scripts/user-workspace-check.mjs",
    "workspace:sync": "node scripts/sync-user-workspace.mjs",
    "preview": "node scripts/serve-cloudflare.mjs",
    "validate": "node scripts/validate-cloudflare.mjs",
    "test:functions": "node scripts/test-cloudflare-functions.mjs",
    "test": "npm run workspace:check && npm run state:check && npm run release:check && npm run build && npm run validate && npm run test:functions"
  }
}
