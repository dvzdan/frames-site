module sloped_wall_prism_x(points_yz, x0, x1){
    polyhedron(
        points=[[x0,points_yz[0][0],points_yz[0][1]],[x0,points_yz[1][0],points_yz[1][1]],[x0,points_yz[2][0],points_yz[2][1]],[x0,points_yz[3][0],points_yz[3][1]],[x1,points_yz[0][0],points_yz[0][1]],[x1,points_yz[1][0],points_yz[1][1]],[x1,points_yz[2][0],points_yz[2][1]],[x1,points_yz[3][0],points_yz[3][1]]],
        faces=[[0,1,2,3],[7,6,5,4],[0,4,5,1],[1,5,6,2],[2,6,7,3],[3,7,4,0]]);
}

channel_bottom_kill_z = 3 * inch;
bottom_front_shelf_y_span = 3.0;
bottom_front_shelf_y0 = front_buildout_y0 + front_frame_t;
bottom_front_shelf_y1     = bottom_front_shelf_y0 + bottom_front_shelf_y_span;

// The image-support shelves no longer need the full historical 3 mm run.
// Keep the old bottom_front_shelf_y1 as the proven clock/backstop datum, while
// this one shared knob shortens both side shelves, the lower sloped-wall root,
// and the center registration/pinch pocket without moving clock hardware.
image_support_shelf_y_span = 2.0;
image_support_shelf_y1 =
    bottom_front_shelf_y0 + image_support_shelf_y_span;

// The 56 mm quartz chassis is 16 mm deep in Y and seats against the +Y face
// of its negative-Y backstop ring. Let the top retainer clear the rear of the
// chassis by exactly 10 mm, but do not carry it needlessly to bottom_d.
clock_chassis_depth_y = 16.0;
clock_top_tab_extra_clearance_y = 10.0;
clock_chassis_front_y = bottom_front_shelf_y1 + 4.0;
clock_top_tab_y1 = clock_chassis_front_y
                   + clock_chassis_depth_y
                   + clock_top_tab_extra_clearance_y;
assert(clock_top_tab_y1 <= bottom_d,
       "clock top tab exceeds available +Y cassette depth");

// Loose center registration pocket for the acrylic + two-image stack.
// Give this center pocket 0.50 mm more +Y release room than the adjacent side
// shelves. This preserves the complete V-jaw thickness for a 0.6 mm nozzle
// while preventing the center feature from pinching a falling stack.
// It stops excess +Y travel without clamping the stack. The cassette prints
// upside down, so three thin posts borrow from the existing removable scaffold
// to support it during printing. The finished mouth stays completely open.
center_stack_pocket_w_x = rear_guard_center_strip_w;
center_stack_pocket_x0 = rear_guard_center_x - center_stack_pocket_w_x/2;
center_stack_pocket_x1 = rear_guard_center_x + center_stack_pocket_w_x/2;
center_stack_pocket_inner_y0 = bottom_front_shelf_y0;
center_stack_pocket_extra_release_y = 0.50;
center_stack_pocket_inner_y1 =
    image_support_shelf_y1 + center_stack_pocket_extra_release_y;
center_stack_pocket_rear_wall_t_y = 1.2;
center_stack_pocket_rear_outer_y1 =
    center_stack_pocket_inner_y1 + center_stack_pocket_rear_wall_t_y;
center_stack_pocket_front_anchor_overlap_y = 0.4;
center_stack_pocket_mouth_z1 = front_view_z0;
center_stack_pocket_chamfer_h_z = 1.2;
center_stack_pocket_chamfer_y = 0.6;
center_stack_pocket_mouth_inner_y1 =
    center_stack_pocket_inner_y1 + center_stack_pocket_chamfer_y;
// A full-width V-tapered slit in the center wall grips a broad range of
// ordinary presentation and photo-paper thicknesses. The cut deliberately
// extends beyond both X faces so neither end is capped. The mouth is roomy
// enough to find without curling the sheet edge; the near-closed root makes
// the paper wedge at its own thickness rather than relying on one exact gap.
center_reveal_pinch_slot_end_open_x = 0.20;
center_reveal_pinch_slot_x0 =
    center_stack_pocket_x0 - center_reveal_pinch_slot_end_open_x;
center_reveal_pinch_slot_x1 =
    center_stack_pocket_x1 + center_reveal_pinch_slot_end_open_x;
center_reveal_pinch_slot_top_clearance_z = 0.0;
center_reveal_pinch_rear_carrier_depth_z =
    3.5 + front_view_lower_lip_raise_z;
center_reveal_pinch_slot_mouth_w_y = 1.15;
center_reveal_pinch_slot_root_w_y = 0.0;
// Give the front/-Y leg a small asymmetric printing allowance. The rear/+Y
// leg and the slit center datum stay fixed; only the front face moves forward.
center_reveal_pinch_slot_front_relief_y = 0.18;
center_reveal_pinch_slot_center_y =
    center_stack_pocket_inner_y1
    + center_stack_pocket_rear_wall_t_y/2;
// The 1.2 mm registration wall cannot carry this slit reliably: its 1.15 mm
// mouth plus the 0.18 mm front printing relief consumes 1.33 mm at the opening,
// and both residual shoulders remain sub-nozzle near the root.  Thicken only
// the V's local rail, symmetrically about the established slit center.  A
// 4.0 mm carrier leaves 0.945 mm in front and 1.425 mm behind the widest mouth.
center_reveal_pinch_carrier_t_y = 4.0;
center_reveal_pinch_carrier_root_embed_z = 1.2;
// Keep the 4.8 mm working slit and zero apex. Remove 1.0 mm only from the TOP
// of the visible front/-Y jaw: its lower pinching throat remains complete and
// continues through the same 1.2 mm root embed as the rear jaw, while the
// nonfunctional material beside the mouth is absent. Trimming its outer face
// by 0.30 mm also keeps it behind the viewing lip.
center_reveal_pinch_front_carrier_trim_y = 0.30;
center_reveal_pinch_front_leg_top_trim_z = 1.0;
// Additional clearance requested at the already-shortened front jaw. This is
// applied as a literal top-face subtraction; no jaw datum or slit dimension
// moves with it.
center_reveal_pinch_front_leg_extra_shave_z = 0.8;
center_reveal_pinch_slot_depth_z = 4.8;
center_reveal_pinch_front_leg_depth_z =
    center_reveal_pinch_slot_depth_z
    -center_reveal_pinch_front_leg_top_trim_z;
center_reveal_pinch_carrier_front_shoulder_y =
    center_reveal_pinch_carrier_t_y/2
    -center_reveal_pinch_slot_mouth_w_y/2
    -center_reveal_pinch_slot_front_relief_y
    -center_reveal_pinch_front_carrier_trim_y;
center_reveal_pinch_carrier_rear_shoulder_y =
    center_reveal_pinch_carrier_t_y/2
    -center_reveal_pinch_slot_mouth_w_y/2;
// The front face of the jaw is the narrowest local passage seen by the
// acrylic/image stack. Keep a deterministic gravity-release clearance here
// rather than thinning the jaw below two nominal 0.6 mm extrusion widths.
center_stack_pocket_min_release_y =
    center_reveal_pinch_slot_center_y
    -center_reveal_pinch_carrier_t_y/2
    +center_reveal_pinch_front_carrier_trim_y
    -center_stack_pocket_inner_y0;
assert(center_reveal_pinch_slot_x1 > center_reveal_pinch_slot_x0,
       "center paper-pinch slit has no positive X span");
assert(center_reveal_pinch_slot_mouth_w_y
       <= center_stack_pocket_rear_wall_t_y + eps,
       "center paper-pinch mouth exceeds the center rear wall");
assert(center_reveal_pinch_carrier_front_shoulder_y
           >= wet_print_nozzle_d-eps,
       "center paper-pinch V front shoulder is under one extrusion width");
assert(center_reveal_pinch_carrier_rear_shoulder_y
           >= 2*wet_print_nozzle_d-eps,
       "center paper-pinch V rear shoulder is under two extrusion widths");
assert(center_stack_pocket_min_release_y >= 1.40-eps,
       "center paper-pinch jaw crowds the gravity-release stack path");
assert(center_reveal_pinch_front_leg_depth_z
           < center_reveal_pinch_rear_carrier_depth_z-eps,
       "center paper-pinch front jaw was not shortened in Z");
assert(center_reveal_pinch_front_leg_extra_shave_z
           < center_reveal_pinch_front_leg_depth_z-eps,
       "center paper-pinch front-jaw shave consumes its working depth");
assert(abs(center_reveal_pinch_slot_depth_z
           -center_reveal_pinch_front_leg_depth_z
           -center_reveal_pinch_front_leg_top_trim_z) < eps,
       "center paper-pinch top trim no longer preserves the zero apex");
assert(center_reveal_pinch_slot_root_w_y == 0,
       "center paper-pinch slit no longer reaches a zero-width apex");
center_stack_pocket_support_post_count = 3;
center_stack_pocket_support_branch_w_x = 1.2;
center_stack_pocket_support_branch_d_y = 1.2;
center_stack_pocket_support_contact_w_x = 1.2;
center_stack_pocket_support_contact_d_y = 0.6;
center_stack_pocket_support_post_x_margin = 2.0;
// All three branches stay in this single Y plane: the center of the narrow
// chamfered rear rim marked in the user's red-line / green-contact review.
center_stack_pocket_support_post_y =
    (center_stack_pocket_mouth_inner_y1
     + center_stack_pocket_rear_outer_y1) / 2;
center_stack_pocket_support_contact_overlap_z = 0.30;
center_stack_pocket_support_contact_z0 =
    center_stack_pocket_mouth_z1
    - center_stack_pocket_support_contact_overlap_z;
center_stack_pocket_support_landing_z0 =
    center_stack_pocket_mouth_z1 + 0.60;
center_stack_pocket_support_landing_h_z = 0.80;

// Centerline of the existing center diagonal scaffold. The trident root is
// placed where that diagonal passes directly over the pocket contact row.
center_stack_pocket_support_diag_lower_y =
    center_stack_pocket_inner_y0 - 0.30;
center_stack_pocket_support_diag_lower_z =
    center_stack_pocket_mouth_z1 + 3.0 + 1.2;
center_stack_pocket_support_diag_upper_y = backer_plane_y - 1.5;
center_stack_pocket_support_diag_upper_z = clock_top_tab_z0 + 22.0;
center_stack_pocket_support_root_y = center_stack_pocket_support_post_y;
center_stack_pocket_support_root_frac =
    (center_stack_pocket_support_root_y
     - center_stack_pocket_support_diag_lower_y)
    / (center_stack_pocket_support_diag_upper_y
       - center_stack_pocket_support_diag_lower_y);
center_stack_pocket_support_root_z =
    center_stack_pocket_support_diag_lower_z
    + center_stack_pocket_support_root_frac
      * (center_stack_pocket_support_diag_upper_z
         - center_stack_pocket_support_diag_lower_z);
center_stack_pocket_support_root_w_x = 1.8;
center_stack_pocket_support_root_d_y = 0.8;
center_stack_pocket_support_root_h_z = 1.2;

assert(center_stack_pocket_inner_y1 - center_stack_pocket_inner_y0
           >= image_support_shelf_y_span-eps,
       "center acrylic/image pocket is narrower than its specified depth");
assert(center_stack_pocket_mouth_inner_y1
       < center_stack_pocket_rear_outer_y1,
       "center pocket chamfer consumes the rear stop wall");
assert(center_stack_pocket_support_root_frac > 0
       && center_stack_pocket_support_root_frac < 1,
       "pocket-support trident root misses the center scaffold diagonal");
assert(center_stack_pocket_support_post_y
           - center_stack_pocket_support_contact_d_y/2
       >= center_stack_pocket_mouth_inner_y1 - eps
       && center_stack_pocket_support_post_y
              + center_stack_pocket_support_contact_d_y/2
          <= center_stack_pocket_rear_outer_y1 + eps,
       "pocket-support contacts miss the narrow rear rim");
// The raised shelf remains the terminal lower end of this channel wall.
// Keep the upper endpoint fixed so shelf adjustment only makes a small Y-Z
// slope change instead of translating the full channel geometry.
rear_wall_slope_z0 = acrylic_shelf_z0;
rear_wall_slope_z1 = rear_guard_z0 - photo_hang_drop + channel_bottom_kill_z;

module rear_wall_column_with_lower_slope(x0, x1){
    x0_lower_fixed = x0;

    // lower sloped waterproofing wall may extend to side wall
    sloped_wall_prism_x(
        [[image_support_shelf_y1, rear_wall_slope_z0],
         [image_support_shelf_y1 + rear_guard_wall_t, rear_wall_slope_z0],
         [wall_offset + rear_guard_wall_t, rear_wall_slope_z1],
         [wall_offset, rear_wall_slope_z1]],
        x0_lower_fixed, x1);

    // upper vertical wall stays original width
    translate([x0, wall_offset, rear_wall_slope_z1])
        cube([x1 - x0, rear_guard_wall_t, rear_guard_z1 - rear_wall_slope_z1]);
}


module rear_buildout_perimeter(){
    rear_guard_top_border_z = 38;
    inner_x0 = rear_guard_x0 + rear_guard_border_x;
    inner_x1 = rear_guard_x1 - rear_guard_border_x;
    inner_z1 = rear_guard_z1 - rear_guard_top_border_z;
    left_col_x0   = rear_guard_x0;
    left_col_x1   = inner_x0;
    right_col_x0  = inner_x1;
    right_col_x1  = rear_guard_x1;
    union(){
        rear_wall_column_with_lower_slope(left_col_x0, left_col_x1);
        rear_wall_column_with_lower_slope(right_col_x0, right_col_x1);
        // Original straight top perimeter/receiver backing remains intact.
        top_bar_extra_z_bottom = 4.0;
        top_bar_extra_z_top = 4.0;
        translate([
            rear_guard_x0,
            wall_offset,
            inner_z1-top_bar_extra_z_bottom
        ])
            cube([
                rear_guard_x1-rear_guard_x0,
                rear_guard_wall_t,
                (rear_guard_z1-inner_z1)
                    +top_bar_extra_z_bottom
                    +top_bar_extra_z_top
            ]);
    }
}

// Permanent floor-down print arch beneath the rear receiver bridge.
// This is deliberately only 1.0 mm deep in Y: it is not a removable support,
// but it has no finished-use load beyond remaining fused to the frame. Its
// +Y face is flush with the rear wall's +Y face, so it directly joins the
// receiver roots without projecting farther into their working envelope.
//
// The low ends begin just above the bend between the sloped lower wall and
// the vertical upper wall. The solid is the material ABOVE the curved lower
// boundary, not a web rising from the remote crossbar.
module rear_receiver_print_arch(){
    // Match the rear wall through Y. This costs only about 1.9 g of PLA versus
    // the former 1 mm skin, removes the conspicuous -Y top-depth transition,
    // and leaves the receiver-side +Y working face exactly where it was.
    arch_t_y = rear_guard_wall_t;
    arch_y1 = wall_offset + rear_guard_wall_t;
    arch_y0 = arch_y1 - arch_t_y;
    arch_x0 = rear_guard_x0 + rear_guard_border_x - eps;
    arch_x1 = rear_guard_x1 - rear_guard_border_x + eps;
    arch_anchor_z = rear_wall_slope_z1 + 1.0;
    arch_top_z = trap_buildout_wall_z0 + eps;
    arch_crown_lower_z = trap_buildout_wall_z0 - 2.4;
    // One pointed curve now owns the complete lower boundary.  The former
    // sin() curve was intrinsically flat at its crown, and the later local
    // correction merely moved that flatness into two shoulder patches.  The
    // 1-|2p-1|^0.9 law has a genuine center cusp, meets both original anchors,
    // and deliberately fills more of the opening everywhere between them.
    // Replace only the final point with a four-nozzle-wide flat land. Its Z is
    // taken from the untouched curve at the land ends, so this adds a small
    // printable meeting area without creating shoulders in the arch.
    arch_point_power = 0.90;
    arch_side_segments = 32;
    // Four nominal 0.6 mm nozzle lines; kept literal because the common wet
    // nozzle datum is declared later in this combined source.
    arch_crown_land_w = 2.4;
    arch_crown_land_half_w = arch_crown_land_w/2;
    arch_crown_land_edge_phase =
        arch_crown_land_half_w/(arch_x1-arch_x0);
    arch_crown_land_rise =
        1-pow(2*arch_crown_land_edge_phase,arch_point_power);
    arch_crown_land_z = arch_anchor_z
        +(arch_crown_lower_z-arch_anchor_z)*arch_crown_land_rise;
    arch_lower_curve = concat(
        [for(i=[0:arch_side_segments])
            let(
                phase = (0.5-arch_crown_land_edge_phase)
                    *i/arch_side_segments,
                x = arch_x0+(arch_x1-arch_x0)*phase,
                rise = 1-pow(abs(2*phase-1),arch_point_power),
                z = arch_anchor_z
                    +(arch_crown_lower_z-arch_anchor_z)*rise
            ) [x,z]],
        [[(arch_x0+arch_x1)/2+arch_crown_land_half_w,
          arch_crown_land_z]],
        [for(i=[1:arch_side_segments])
            let(
                phase = 0.5+arch_crown_land_edge_phase
                    +(0.5-arch_crown_land_edge_phase)
                        *i/arch_side_segments,
                x = arch_x0+(arch_x1-arch_x0)*phase,
                rise = 1-pow(abs(2*phase-1),arch_point_power),
                z = arch_anchor_z
                    +(arch_crown_lower_z-arch_anchor_z)*rise
            ) [x,z]]
    );
    arch_profile = concat(
        [[arch_x0,arch_top_z],[arch_x1,arch_top_z]],
        [for(i=[len(arch_lower_curve)-1:-1:0]) arch_lower_curve[i]]
    );

    translate([0,arch_y1,0])
        rotate([90,0,0])
            linear_extrude(height=arch_y1-arch_y0)
                polygon(points=arch_profile);
}

// Conventional permanent 45-degree wedges beneath the two lower receiver
// shelves. Each grows from the arch/rear-wall plane toward +Y and meets the
// shelf at its free edge. A narrow centered X footprint is enough to establish
// every layer without obstructing the receiver pocket.
module rear_receiver_print_wedges(){
    wedge_w_x = 1.2;
    wedge_wall_y = wall_offset + rear_guard_wall_t - eps;
    wedge_tip_y = trap_lip_y1;
    wedge_run_y = wedge_tip_y - wedge_wall_y;
    wedge_shelf_z = trap_buildout_wall_z0;
    wedge_centers_x = [
        trap_lip_corner_x + trap_lip_bottom_len_x/2,
        trap_rig_x1 - trap_lip_bottom_len_x/2
    ];

    for(xc=wedge_centers_x)
        triangular_prism_x(
            [
                [wedge_wall_y, wedge_shelf_z-wedge_run_y],
                [wedge_wall_y, wedge_shelf_z+eps],
                [wedge_tip_y,  wedge_shelf_z+eps]
            ],
            xc-wedge_w_x/2,
            xc+wedge_w_x/2
        );
}

module bottom_front_shelves(){
    translate([rear_guard_x0, bottom_front_shelf_y0, acrylic_shelf_z0])
        cube([rear_guard_border_x, image_support_shelf_y1 - bottom_front_shelf_y0, acrylic_shelf_t]);
    // Permanent 45-degree underside wedge follows the shortened shelf run.
    triangular_prism_x(
        [[bottom_front_shelf_y0, acrylic_shelf_z0],
         [image_support_shelf_y1, acrylic_shelf_z0],
         [bottom_front_shelf_y0,
          acrylic_shelf_z0-image_support_shelf_y_span]],
        rear_guard_x0,
        rear_guard_x0 + rear_guard_border_x);
    // The former center shelf segment was a legacy nub directly below the
    // middle scaffold contact. It served no retention function and confused
    // removal, so only the useful left and right shelf segments remain.
    translate([rear_guard_x1 - rear_guard_border_x, bottom_front_shelf_y0, acrylic_shelf_z0])
        cube([rear_guard_border_x, image_support_shelf_y1 - bottom_front_shelf_y0, acrylic_shelf_t]);
    triangular_prism_x(
        [[bottom_front_shelf_y0, acrylic_shelf_z0],
         [image_support_shelf_y1, acrylic_shelf_z0],
         [bottom_front_shelf_y0,
          acrylic_shelf_z0-image_support_shelf_y_span]],
        rear_guard_x1 - rear_guard_border_x,
        rear_guard_x1);
}

// Reveal-image edge grip. The subtraction runs beyond both X end faces, leaving
// a true continuous slit with no end caps. In functional orientation the paper
// drops into the wide mouth and wedges progressively as the slit narrows. In
// the established inverted print orientation the mouth begins first, so the
// negative feature grows without a trapped roof or bridge.
module center_reveal_paper_pinch_slit_cut(){
    slit_surface_z = center_stack_pocket_mouth_z1
        - center_reveal_pinch_slot_top_clearance_z;
    slit_z1 = slit_surface_z + eps;
    slit_z0 = slit_surface_z - center_reveal_pinch_slot_depth_z;

    // One triangular cut: the asymmetric entry relief exists only at the
    // mouth and converges with both working faces to the same zero-width apex.
    triangular_prism_x(
        [[center_reveal_pinch_slot_center_y, slit_z0],
         [center_reveal_pinch_slot_center_y
              + center_reveal_pinch_slot_mouth_w_y/2, slit_z1],
         [center_reveal_pinch_slot_center_y
              - center_reveal_pinch_slot_mouth_w_y/2
              - center_reveal_pinch_slot_front_relief_y, slit_z1]],
        center_reveal_pinch_slot_x0,
        center_reveal_pinch_slot_x1);
}

module center_reveal_pinch_front_jaw_extra_shave_cut(){
    // Remove only the next 0.8 mm from the already-trimmed front/-Y jaw top.
    // Overshoot X and Y by eps so this remains a clean subtraction rather than
    // changing the carrier cube, V slit, rear jaw, or lower pinching throat.
    translate([
        center_stack_pocket_x0-eps,
        center_reveal_pinch_slot_center_y
            -center_reveal_pinch_carrier_t_y/2
            +center_reveal_pinch_front_carrier_trim_y-eps,
        center_stack_pocket_mouth_z1
            -center_reveal_pinch_front_leg_top_trim_z
            -center_reveal_pinch_front_leg_extra_shave_z
    ])
        cube([
            center_stack_pocket_x1-center_stack_pocket_x0+2*eps,
            center_reveal_pinch_carrier_t_y/2
                -center_reveal_pinch_front_carrier_trim_y+2*eps,
            center_reveal_pinch_front_leg_extra_shave_z+2*eps
        ]);
}

// NEUTRAL: shared acrylic/image +Y registration stop.
// The existing lower front mask is the -Y side of this U-shaped pocket. The
// new floor and chamfered rear wall form its base and +Y stop. At the center,
// the removable membrane overlaps the scaffold contact during inverted
// printing; the permanent pocket remains attached to the front mask after
// both temporary features are cut away.
module center_stack_registration_pocket(){
    floor_y0 =
        center_stack_pocket_inner_y0
        - center_stack_pocket_front_anchor_overlap_y;
    rear_chamfer_z0 =
        center_stack_pocket_mouth_z1
        - center_stack_pocket_chamfer_h_z;
    difference(){
        union(){
    // Dedicated full-width V carrier, split only so its two working jaws can
    // have different hidden depths. The rear/+Y jaw retains the complete
    // original root embed. The visible front/-Y jaw retains the same lower
    // endpoint through the root embed below the V apex, but stops 1.0 mm below
    // the mouth and begins 0.30 mm farther +Y. The slit subtraction supplies
    // the working taper.
    translate([
        center_stack_pocket_x0,
        center_reveal_pinch_slot_center_y,
        center_stack_pocket_mouth_z1
            -center_reveal_pinch_rear_carrier_depth_z
            -center_reveal_pinch_carrier_root_embed_z
    ])
        cube([
            center_stack_pocket_x1-center_stack_pocket_x0,
            center_reveal_pinch_carrier_t_y/2,
            center_reveal_pinch_rear_carrier_depth_z
                +center_reveal_pinch_carrier_root_embed_z+eps
        ]);

    translate([
        center_stack_pocket_x0,
        center_reveal_pinch_slot_center_y
            -center_reveal_pinch_carrier_t_y/2
            +center_reveal_pinch_front_carrier_trim_y,
        center_stack_pocket_mouth_z1
            -center_reveal_pinch_slot_depth_z
            -center_reveal_pinch_carrier_root_embed_z
    ])
        cube([
            center_stack_pocket_x1-center_stack_pocket_x0,
            center_reveal_pinch_carrier_t_y/2
                -center_reveal_pinch_front_carrier_trim_y,
            center_reveal_pinch_front_leg_depth_z
                +center_reveal_pinch_carrier_root_embed_z+eps
        ]);

    // Horizontal seat, level with the two existing side shelves.
    translate([
        center_stack_pocket_x0,
        floor_y0,
        acrylic_shelf_z0
    ])
        cube([
            center_stack_pocket_x1 - center_stack_pocket_x0,
            center_stack_pocket_rear_outer_y1 - floor_y0,
            acrylic_shelf_t
        ]);

    // This center seat projects farther than the side shelves, so support its
    // complete underside with the same wall-rooted 45-degree rule.
    center_shelf_projection_y = center_stack_pocket_rear_outer_y1 - floor_y0;
    triangular_prism_x(
        [[floor_y0, acrylic_shelf_z0],
         [center_stack_pocket_rear_outer_y1, acrylic_shelf_z0],
         [floor_y0, acrylic_shelf_z0-center_shelf_projection_y]],
        center_stack_pocket_x0,
        center_stack_pocket_x1);

    // Straight lower part of the +Y stop wall.
    translate([
        center_stack_pocket_x0,
        center_stack_pocket_inner_y1,
        acrylic_shelf_top_z - eps
    ])
        cube([
            center_stack_pocket_x1 - center_stack_pocket_x0,
            center_stack_pocket_rear_wall_t_y,
            rear_chamfer_z0 - acrylic_shelf_top_z + 2*eps
        ]);

    // Simple outward flare so acrylic and paper edges enter without snagging.
    sloped_wall_prism_x(
        [[center_stack_pocket_inner_y1, rear_chamfer_z0 - eps],
         [center_stack_pocket_rear_outer_y1, rear_chamfer_z0 - eps],
         [center_stack_pocket_rear_outer_y1,
          center_stack_pocket_mouth_z1],
         [center_stack_pocket_mouth_inner_y1,
          center_stack_pocket_mouth_z1]],
        center_stack_pocket_x0,
        center_stack_pocket_x1
    );

        }
        center_reveal_paper_pinch_slit_cut();
        center_reveal_pinch_front_jaw_extra_shave_cut();
    }
}

// PRINT-SUPPORTS ONLY: a three-branch trident rooted directly in the underside
// of the existing center diagonal scaffold. The branches fan to the three
// narrow rear-rim contacts that are first to print; nothing new touches the
// visible viewing-window lip or the already-supported broad pocket floor.
module center_stack_pocket_sacrificial_posts(){
    post_x_span = center_stack_pocket_w_x
        - 2*center_stack_pocket_support_post_x_margin;

    for(i = [0 : center_stack_pocket_support_post_count - 1]){
        post_x = center_stack_pocket_x0
            + center_stack_pocket_support_post_x_margin
            + i * post_x_span
              / (center_stack_pocket_support_post_count - 1);

        // Each branch is a two-line-width body. The side branches remain
        // steeper than 45 degrees and the middle branch is nearly vertical.
        hull(){
            translate([
                rear_guard_center_x
                    - center_stack_pocket_support_root_w_x/2,
                center_stack_pocket_support_root_y
                    - center_stack_pocket_support_root_d_y/2,
                center_stack_pocket_support_root_z
                    - center_stack_pocket_support_root_h_z/2
            ])
                cube([
                    center_stack_pocket_support_root_w_x,
                    center_stack_pocket_support_root_d_y,
                    center_stack_pocket_support_root_h_z
                ]);
            translate([
                post_x - center_stack_pocket_support_branch_w_x/2,
                center_stack_pocket_support_post_y
                    - center_stack_pocket_support_branch_d_y/2,
                center_stack_pocket_support_landing_z0
            ])
                cube([
                    center_stack_pocket_support_branch_w_x,
                    center_stack_pocket_support_branch_d_y,
                    center_stack_pocket_support_landing_h_z
                ]);
        }

        // One shallow layer-scale foot on the narrow rim is the only removable
        // contact. This supports the first pocket layer instead of arriving
        // later on the already-printed floor.
        translate([
            post_x - center_stack_pocket_support_contact_w_x/2,
            center_stack_pocket_support_post_y
                - center_stack_pocket_support_contact_d_y/2,
            center_stack_pocket_support_contact_z0
        ])
            cube([
                center_stack_pocket_support_contact_w_x,
                center_stack_pocket_support_contact_d_y,
                center_stack_pocket_support_landing_z0
                    + eps
                    - center_stack_pocket_support_contact_z0
            ]);
    }
}

module acrylic_top_feed_cut(){
    // Extend through the independent roof skin without moving the slot.
    reinforcement_cut_z0 = acrylic_top_feed_z0-top_cross_reinforcement_t;
    translate([acrylic_top_feed_x0,acrylic_slot_y0,reinforcement_cut_z0])
        cube([
            acrylic_top_feed_x1-acrylic_top_feed_x0,
            acrylic_slot_y1-acrylic_slot_y0,
            acrylic_top_feed_z1-reinforcement_cut_z0
        ]);
}

// DRY-ONLY: permanent +Y gusset for the extended clock-retainer tab. Unlike
// the former support pair, this exists only at the remote +Y end and rises
// into the tab body. The overlap makes a broad fused transition instead of a
// tab that merely appears to sit on the edge of a triangular support.
module right_outer_clock_tab_rear_gusset(){
    tab_x0 = cutout_x + cutout_w - clock_tab_w - 8;
    gusset_y_band = 1.8;
    gusset_rise_into_tab_z = 2.0;
    gusset_drop_z = 6.0;
    gusset_overlap_into_tab_x = 2.0;

    triangular_prism_y(
        [[wall_w - side_panel_t,
          clock_top_tab_z0 + gusset_rise_into_tab_z],
         [wall_w - side_panel_t,
          clock_top_tab_z0 - gusset_drop_z],
         [tab_x0 + gusset_overlap_into_tab_x,
          clock_top_tab_z0 + gusset_rise_into_tab_z]],
        clock_top_tab_y1 - gusset_y_band,
        clock_top_tab_y1 + eps);
}

module left_floor_corner_gusset(){
    ramp_x_t = .6;
    ramp_z0  = bottom_t - 1.2;
    ramp_z1  = bottom_t + 20.0;

    gusset_end_cliff_z = 2.0;

    y0 = front_buildout_y0 + front_frame_t;
    y1 = side_lip_y1 + 1;

    sloped_wall_prism_x(
        [[y0, ramp_z0],
         [y0, ramp_z1],
         [y1, ramp_z0 + gusset_end_cliff_z],
         [y1, ramp_z0]],
        0, ramp_x_t);
}

module front_mask_plane(){
    difference(){
        union(){
            translate([buildout_x0, front_buildout_y0, buildout_z0])
                cube([wall_w, front_frame_t, buildout_z1-buildout_z0]);
            x_mid        = wall_w/2;
            core_half    = mask_core_w/2;
            total_half   = mask_total_w/2;
            dx           = mask_total_w / mask_slices;
            reinforce_z1 = lower_front_fill_z1;
            for(i = [0 : mask_slices-1]){
                xa = x_mid - total_half + i*dx;
                xc = xa + dx/2;
                d  = abs(xc - x_mid);
                extra = (d <= core_half) ? mask_center_extra_y : (d <= total_half) ? mask_center_extra_y * pow(1 - (d - core_half)/(total_half - core_half), 2) : 0;
                if (extra > 0)
                    translate([xa, front_buildout_y0 + front_frame_t, buildout_z0])
                        cube([dx, extra, reinforce_z1 - buildout_z0]);
            }
        }
        translate([view_x0, front_buildout_y0-0.1, front_view_z0])
            cube([view_w, front_frame_t+0.2, front_view_h]);
        front_window_chamfer(2.0);
    }
}

acrylic_bottom_nub_x = 5.0;
acrylic_bottom_nub_y = 3.0;
acrylic_bottom_nub_z = 3.0;
acrylic_bottom_nub_z0 = shelf_edge_z + 3.0;

module acrylic_bottom_side_nubs(){
    translate([side_panel_t, acrylic_slot_y1, acrylic_bottom_nub_z0])
        cube([acrylic_bottom_nub_x, acrylic_bottom_nub_y, acrylic_bottom_nub_z]);
    triangular_prism_y(
        [[side_panel_t, acrylic_bottom_nub_z0 - acrylic_bottom_nub_x],
         [side_panel_t, acrylic_bottom_nub_z0],
         [side_panel_t + acrylic_bottom_nub_x, acrylic_bottom_nub_z0]],
        acrylic_slot_y1, acrylic_slot_y1 + acrylic_bottom_nub_y);
    translate([wall_w - side_panel_t - acrylic_bottom_nub_x, acrylic_slot_y1, acrylic_bottom_nub_z0])
        cube([acrylic_bottom_nub_x, acrylic_bottom_nub_y, acrylic_bottom_nub_z]);
    triangular_prism_y(
        [[wall_w - side_panel_t, acrylic_bottom_nub_z0 - acrylic_bottom_nub_x],
         [wall_w - side_panel_t, acrylic_bottom_nub_z0],
         [wall_w - side_panel_t - acrylic_bottom_nub_x, acrylic_bottom_nub_z0]],
        acrylic_slot_y1, acrylic_slot_y1 + acrylic_bottom_nub_y);
}

// Three paired side stops keep the narrower acrylic centered in the existing
// broad channel. They occupy only the space outside acrylic_channel_x0/x1 and
// are hidden behind the opaque side borders of the viewing window.
acrylic_side_stop_h_z = 5.0;
acrylic_side_stop_front_overlap_y = 0.60;
acrylic_side_stop_back_overlap_y = 0.60;
acrylic_side_stop_lower_z = view_z0 + 12.0;
acrylic_side_stop_middle_z = (view_z0 + view_z1)/2;
acrylic_side_stop_upper_z = view_z1 - 12.0;

module acrylic_lateral_stop_pair(z_center){
    stop_y0 = acrylic_slot_y0 - acrylic_side_stop_front_overlap_y;
    stop_y1 = max(acrylic_slot_y1, acrylic_inner_y1)
              + acrylic_side_stop_back_overlap_y;
    stop_z0 = z_center - acrylic_side_stop_h_z/2;

    assert(acrylic_channel_x0 > rear_guard_x0,
           "Left acrylic stop has no positive X width; reduce sheet width or clearance.");
    assert(acrylic_channel_x1 < rear_guard_x1,
           "Right acrylic stop has no positive X width; reduce sheet width or clearance.");

    translate([rear_guard_x0, stop_y0, stop_z0])
        cube([
            acrylic_channel_x0 - rear_guard_x0,
            stop_y1 - stop_y0,
            acrylic_side_stop_h_z
        ]);

    translate([acrylic_channel_x1, stop_y0, stop_z0])
        cube([
            rear_guard_x1 - acrylic_channel_x1,
            stop_y1 - stop_y0,
            acrylic_side_stop_h_z
        ]);
}

module acrylic_lateral_stops(){
    acrylic_lateral_stop_pair(acrylic_side_stop_lower_z);
    acrylic_lateral_stop_pair(acrylic_side_stop_middle_z);
    acrylic_lateral_stop_pair(acrylic_side_stop_upper_z);
}

module paper_load_top_slot_cut(){
    paper_load_slot_w_y = 1.2;

    // Slight +Y bias from roller/nub centerline.
    // Keeps a substantial web from acrylic/front slot, but not so far back
    // that loading requires sharply bending the paper forward.
    paper_load_slot_offset_y = -10.0;

    // Extra X forgiveness beyond actual paper slot, not full roller width.
    paper_load_slot_x_extra = 8.0;

    paper_load_slot_x0 = paper_slot_x0 - paper_load_slot_x_extra;
    paper_load_slot_x1 = paper_slot_x1 + paper_load_slot_x_extra;

    paper_load_slot_y0 = nipple_cy + paper_load_slot_offset_y;
    paper_load_slot_y1 = paper_load_slot_y0 + paper_load_slot_w_y;

    translate([
        paper_load_slot_x0,
        paper_load_slot_y0,
        top_cross_z0 - top_cross_reinforcement_t - eps
    ])
        cube([
            paper_load_slot_x1 - paper_load_slot_x0,
            paper_load_slot_y1 - paper_load_slot_y0,
            top_cross_z_len + top_cross_reinforcement_t + 2*eps
        ]);
}
module front_buildout_parts(){
    front_mask_plane();
    // Preserve the original channel assembly in place. Only its roofward end
    // is removed, by subtraction at the new track-clearance plane.
    restored_side_channels_clipped();
    bottom_front_shelves();
    center_stack_registration_pocket();
    acrylic_lateral_stops();
    side_channel_terminal_side_braces();
    acrylic_bottom_side_nubs();
    
}

module front_window_chamfer(bevel=2.0){
    translate([0, front_buildout_y0 - 0.1, 0])
        rotate([-90,0,0])
            linear_extrude(height = front_frame_t + 0.2, scale = [(view_w + 2*bevel) / view_w, (front_view_h + 2*bevel) / front_view_h])
                translate([view_x0 + view_w/2, front_view_z0 + front_view_h/2])
                    translate([-view_w/2, -front_view_h/2])
                        square([view_w, front_view_h]);
}

// VARIANT-SPECIFIC CALLS, SHARED MODULE DEFINITION:
// Native placement is the dry/right clock-side thread hook.
// wet_variant_additive_features() reuses this same shape by translating it
// upward on the same wall. Do not gate the definition itself.
module thread_redirect_local_shape(){
    difference() {
        polyhedron(
            points = [[0,0,0],[0,10,0],[7,0,0],[0,0,7],[0,10,7],[7,0,7]],
            faces  = [[0,1,2],[5,4,3],[0,3,4,1],[1,4,5,2],[2,5,3,0]]);
        translate([3.5, 8, 3.5])
            rotate([90,0,0])
                cylinder(h=14, d=3.5, $fn=32);
    }
}

thread_redirect_floor_down_tip_flat = 1.2;
thread_redirect_wall_chunk_void_w_x = 3.0;
thread_redirect_wall_chunk_void_local_z0 = 3.5;
thread_redirect_wall_chunk_bridge_t = 1.2;
// Explicit two-line width for the 0.6 mm nozzle. This guide is declared before
// the wet-system parameter block, so it must not depend on wet_print_nozzle_d.
thread_redirect_side_load_slot_w = 1.2;
thread_redirect_side_load_bore_cx = 3.5;
thread_redirect_side_load_bore_local_z = 3.5;
thread_redirect_side_load_bore_r = 1.75;
thread_redirect_contact_chamfer = 0.6;
thread_redirect_bore_face_chamfer_depth = 1.4;
// After right_thread_hook() rotates the local guide into place, local +Z maps
// to world +Y.  Reach the bore centerline without changing the connector's
// local-Y span, which is its already-correct installed/world-Z profile.
thread_redirect_side_load_connector_depth =
    thread_redirect_side_load_bore_local_z-1.65;
thread_redirect_side_load_connector_h = 1.8;
thread_redirect_side_load_connector_y0 =
    (thread_redirect_side_load_bore_cx
       -thread_redirect_side_load_slot_w/2)
    *(10-thread_redirect_floor_down_tip_flat)/7;
module thread_redirect_floor_down_outer_shape(){
    linear_extrude(height=7)
        polygon(points=[
            [0,0],
            [0,10],
            [7,10],
            [7,10-thread_redirect_floor_down_tip_flat]
        ]);
}

module thread_redirect_wall_chunk_bridge_local(){
    slope = (10-thread_redirect_floor_down_tip_flat)/7;
    run_x1 = thread_redirect_wall_chunk_void_w_x;

    translate([0,0,thread_redirect_wall_chunk_void_local_z0])
        linear_extrude(
            height=7-thread_redirect_wall_chunk_void_local_z0+eps
        )
            polygon(points=[
                [0,0],
                [run_x1,slope*run_x1],
                [run_x1,slope*run_x1
                    +thread_redirect_wall_chunk_bridge_t],
                [0,thread_redirect_wall_chunk_bridge_t]
            ]);
}

// DRY floor-down form: invert the complete working feature so both its outer
// body and its bore face upward.  A short flat replaces the delicate projecting
// knife point and gives similar wedge features a more printable termination.
module thread_redirect_floor_down_local_shape(){
    difference() {
        linear_extrude(height=7)
            polygon(points=[
                [0,0],
                [0,10],
                [7,10],
                [7,10-thread_redirect_floor_down_tip_flat]
            ]);

        // Full Y-mirror of the established bore: it now opens through the
        // upward face instead of terminating inside the inverted body.
        translate([3.5, 16, 3.5])
            rotate([90,0,0])
                cylinder(h=14, d=3.5, $fn=32);

        // One large wall-adjacent loading column. Local +Z installs as world
        // +Y; local Y installs vertically in world Z. Cutting through the
        // complete local-Y span prevents a residual foot at either end.
        difference(){
            translate([
                -eps,
                -eps,
                thread_redirect_wall_chunk_void_local_z0
            ])
                cube([
                    thread_redirect_wall_chunk_void_w_x+eps,
                    10+2*eps,
                    7-thread_redirect_wall_chunk_void_local_z0+eps
                ]);

            if(print_supports)
                thread_redirect_wall_chunk_bridge_local();
        }
    }
}

module right_thread_hook(){
    translate([wall_w, bottom_d - 22.0, fang_main_z0 - 6.0])
        rotate([90,0,180])
            thread_redirect_floor_down_local_shape();
}

// Independent wet cleat above the restored shared thread guide. These local
// coordinates use the guide's own installation transform: local +X becomes
// installed -X, local +Y becomes world +Z, and local +Z becomes world +Y.
thread_cleat_run_x = 14.0;
thread_cleat_root_bottom_y = 16.0;
thread_cleat_tip_rise_y = 1.4;
thread_cleat_body_h_y = 3.4;
thread_cleat_depth_z = 3.4;
thread_cleat_local_z0 = (7-thread_cleat_depth_z)/2;
thread_cleat_v_center_x = 11.2;
thread_cleat_v_mouth_w_x = 3.4;
thread_cleat_v_depth_y = 1.6;
thread_cleat_v_clockwise_deg = 8;
thread_cleat_v_mouth_overshoot_y = 1.2;
thread_cleat_lower_apron_x0 = 0.0;
thread_cleat_lower_apron_drop_y = 2.0;
thread_cleat_lower_apron_overlap_y = 0.8;
thread_cleat_u_center_x = thread_cleat_v_center_x;
thread_cleat_u_r = 1.3;
thread_cleat_u_throat_w_x = 2*thread_cleat_u_r;
thread_cleat_support_t_y = 1.2;
thread_cleat_secondary_rib_root_x = 8.5;
thread_cleat_secondary_rib_join_t = 0.55;

function thread_cleat_bottom_y_at_x(x) =
    thread_cleat_root_bottom_y
    +thread_cleat_tip_rise_y*x/thread_cleat_run_x;

function thread_cleat_apron_bottom_y_at_x(x) =
    thread_cleat_bottom_y_at_x(x)-thread_cleat_lower_apron_drop_y;

function thread_cleat_v_rotated_point(p,c) = [
    c[0]
        +(p[0]-c[0])*cos(-thread_cleat_v_clockwise_deg)
        -(p[1]-c[1])*sin(-thread_cleat_v_clockwise_deg),
    c[1]
        +(p[0]-c[0])*sin(-thread_cleat_v_clockwise_deg)
        +(p[1]-c[1])*cos(-thread_cleat_v_clockwise_deg)
];

thread_cleat_v_apex_y =
    thread_cleat_bottom_y_at_x(thread_cleat_v_center_x)
    +thread_cleat_body_h_y
    -thread_cleat_v_depth_y*cos(thread_cleat_v_clockwise_deg);
thread_cleat_u_crown_y =
    thread_cleat_apron_bottom_y_at_x(thread_cleat_u_center_x)
    +2*thread_cleat_u_r;
thread_cleat_v_u_web_y =
    thread_cleat_v_apex_y-thread_cleat_u_crown_y;

assert(thread_cleat_v_u_web_y >= thread_cleat_support_t_y-eps,
       "upper V point leaves less than a two-line web above the underside U");

module thread_cleat_body_local(){
    v_top_c = thread_cleat_bottom_y_at_x(thread_cleat_v_center_x)
        +thread_cleat_body_h_y;
    v_center = [thread_cleat_v_center_x,v_top_c];
    v_points = [
        thread_cleat_v_rotated_point([
            thread_cleat_v_center_x-thread_cleat_v_mouth_w_x/2,
            v_top_c+thread_cleat_v_mouth_overshoot_y
        ],v_center),
        thread_cleat_v_rotated_point([
            thread_cleat_v_center_x,
            v_top_c-thread_cleat_v_depth_y
        ],v_center),
        thread_cleat_v_rotated_point([
            thread_cleat_v_center_x+thread_cleat_v_mouth_w_x/2,
            v_top_c+thread_cleat_v_mouth_overshoot_y
        ],v_center)
    ];

    u_center_y = thread_cleat_apron_bottom_y_at_x(
        thread_cleat_u_center_x)+thread_cleat_u_r;
    throat_y0 = thread_cleat_apron_bottom_y_at_x(
        thread_cleat_u_center_x-thread_cleat_u_throat_w_x/2)-eps;

    difference(){
        union(){
            linear_extrude(height=thread_cleat_depth_z)
                polygon(points=[
                    [0,thread_cleat_bottom_y_at_x(0)],
                    [thread_cleat_run_x,
                     thread_cleat_bottom_y_at_x(thread_cleat_run_x)],
                    [thread_cleat_run_x,
                     thread_cleat_bottom_y_at_x(thread_cleat_run_x)
                        +thread_cleat_body_h_y],
                    [0,thread_cleat_bottom_y_at_x(0)
                        +thread_cleat_body_h_y]
                ]);

            // Pitched lower mass for the opposing U. It now spans the complete
            // upper hitch while the space down to the lower guide stays open.
            linear_extrude(height=thread_cleat_depth_z)
                polygon(points=[
                    [thread_cleat_lower_apron_x0,
                     thread_cleat_apron_bottom_y_at_x(
                         thread_cleat_lower_apron_x0)],
                    [thread_cleat_run_x,
                     thread_cleat_apron_bottom_y_at_x(
                         thread_cleat_run_x)],
                    [thread_cleat_run_x,
                     thread_cleat_bottom_y_at_x(thread_cleat_run_x)
                        +thread_cleat_lower_apron_overlap_y],
                    [thread_cleat_lower_apron_x0,
                     thread_cleat_bottom_y_at_x(
                         thread_cleat_lower_apron_x0)
                        +thread_cleat_lower_apron_overlap_y]
                ]);
        }

        translate([0,0,-eps])
            linear_extrude(height=thread_cleat_depth_z+2*eps)
                polygon(points=v_points);

        // Opposing underside U: a rounded seat with a straight downward mouth.
        translate([0,0,-eps])
            linear_extrude(height=thread_cleat_depth_z+2*eps)
                union(){
                    translate([thread_cleat_u_center_x,u_center_y])
                        circle(r=thread_cleat_u_r,$fn=48);
                    translate([
                        thread_cleat_u_center_x
                            -thread_cleat_u_throat_w_x/2-eps,
                        throat_y0
                    ])
                        square([
                            thread_cleat_u_throat_w_x+2*eps,
                            u_center_y-throat_y0+eps
                        ]);
                }
    }
}

module thread_cleat_print_support_local(){
    // One literal 1.2 mm hull: basic contact at the guide's flat tip and at
    // the pitched cleat underside, with no auxiliary posts or broad web.
    linear_extrude(height=thread_cleat_depth_z)
        hull(){
            translate([7,10-thread_redirect_floor_down_tip_flat])
                square([eps,thread_cleat_support_t_y]);
            translate([
                thread_cleat_run_x,
                thread_cleat_apron_bottom_y_at_x(thread_cleat_run_x)
            ])
                square([eps,thread_cleat_support_t_y]);
        }
}

module thread_cleat_secondary_rib_local(){
    guide_tip_x = 7;
    guide_tip_y = 10-thread_redirect_floor_down_tip_flat;
    cleat_tip_x = thread_cleat_run_x;
    cleat_tip_y = thread_cleat_apron_bottom_y_at_x(
        thread_cleat_run_x);
    join_x = guide_tip_x
        +(cleat_tip_x-guide_tip_x)*thread_cleat_secondary_rib_join_t;
    join_y = guide_tip_y
        +(cleat_tip_y-guide_tip_y)*thread_cleat_secondary_rib_join_t;
    root_y = thread_cleat_apron_bottom_y_at_x(
        thread_cleat_secondary_rib_root_x);

    // This brace remains with the upper hitch. Once the lower end of the long
    // diagonal is snipped, no second cut is needed at the stalactite tip.
    linear_extrude(height=thread_cleat_depth_z)
        hull(){
            translate([thread_cleat_secondary_rib_root_x,root_y])
                square([eps,thread_cleat_support_t_y]);
            translate([join_x,join_y])
                square([eps,thread_cleat_support_t_y]);
        }
}

module right_thread_triangle_cleat_hitch(){
    translate([wall_w, bottom_d - 22.0, fang_main_z0 - 6.0])
        rotate([90,0,180])
            translate([0,0,thread_cleat_local_z0])
                union(){
                    thread_cleat_body_local();
                    if(print_supports){
                        thread_cleat_print_support_local();
                        thread_cleat_secondary_rib_local();
                    }
                }
}

// The vertical bore is cut from local Y=2 through Y=16. After the installed
// rotations, that local Y axis is world Z, so Y=2 is the actual loaded thread
// floor. Use this functional datum rather than the guide's bounding-box top.
thread_redirect_dry_working_floor_z = fang_main_z0 - 6.0 + 2.0;
// The floor-down guide's solid local Y span is 0..10, which becomes world Z
// after installation. Track its real top so a wet feature can coexist above it.
thread_redirect_dry_body_top_z = fang_main_z0 - 6.0 + 10.0;

dry_string_access_len_y = 6.0;
dry_string_access_h_z = 1.4;
dry_string_access_guide_gap_z = 1.2;
dry_string_access_yc = bottom_d - 22.0 + 3.5;
dry_string_access_z1 = fang_main_z0 - 6.0 - dry_string_access_guide_gap_z;
dry_string_access_zc = dry_string_access_z1 - dry_string_access_h_z/2;
dry_string_access_end_center_run_y =
    dry_string_access_len_y - dry_string_access_h_z;

module dry_external_string_access_slit_void(){
    hull(){
        for(y = [
            dry_string_access_yc - dry_string_access_end_center_run_y/2,
            dry_string_access_yc + dry_string_access_end_center_run_y/2
        ])
