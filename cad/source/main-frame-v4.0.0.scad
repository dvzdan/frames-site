// =========================================================
// EXPERIMENTAL TWO-INCH TOP / REMOVABLE-ROOF FIT COUPON
// =========================================================
// Preserve the complete X/Y roof joint and the upper 50.8 mm of the cassette,
// but discard the rest of the tall body. Two broad end feet fuse only to the
// new cut edge, keeping the coupon upright without altering the roof junction.
top_roof_test_h_z = 2*inch;
top_roof_test_z0 = shell_inner_top_z - top_roof_test_h_z;
top_roof_test_crop_pad = 0.20;
top_roof_test_foot_t_z = 2.40;
top_roof_test_foot_w_x = 18.0;
top_roof_test_foot_front_y = 10.0;
top_roof_test_foot_rear_y = 10.0;
top_roof_test_roof_gap_y = 6.0;

module top_roof_test_cassette_segment(){
    translate([0, 0, -top_roof_test_z0])
        intersection(){
            cassette_body(false);
            translate([
                -top_roof_test_crop_pad,
                true_full_y0-top_roof_test_crop_pad,
                top_roof_test_z0
            ])
                cube([
                    wall_w + 2*top_roof_test_crop_pad,
                    body_y_max-true_full_y0 + 2*top_roof_test_crop_pad,
                    top_roof_test_h_z + top_roof_test_crop_pad
                ]);
        }
}

module top_roof_test_feet(){
    foot_y0 = true_full_y0-top_roof_test_foot_front_y;
    foot_d_y = body_y_max-true_full_y0
               + top_roof_test_foot_front_y
               + top_roof_test_foot_rear_y;

    for(foot_x0=[0, wall_w-top_roof_test_foot_w_x])
        translate([foot_x0, foot_y0, 0])
            cube([
                top_roof_test_foot_w_x,
                foot_d_y,
                top_roof_test_foot_t_z
            ]);
}

module top_roof_test_print_layout(){
    union(){
        top_roof_test_cassette_segment();
        top_roof_test_feet();
    }

    // Keep the roof in its established outer-face-down print orientation,
    // beyond the rear reach of the new stabilizing feet.
    translate([
        0,
        body_y_max + top_roof_test_foot_rear_y
        + top_roof_test_roof_gap_y,
        0
    ])
        removable_roof_inverted();
}

