// CLEANED ACTIVE CASSETTE FILE — DRY/WET VARIANT SWITCHES
//
// Current experiment:
// - replace the delicate drip aperture with a robust direct-drop outlet;
// - replace the removable bucket with a fused lower reservoir and narrow riser;
// - branch a roomy funnel-bottom sponge cup from the high water column;
// - side-load the PVA string through two small captive high saddles;
// - double-wrap one rounded internal post through opposed dog-legged cleaves;
// - jam only the unloaded tag end in the narrowing cleave;
// - provide a bottom drain for a commercial snap-lock silicone plug.

$fn = $preview ? 24 : 128;
inch=25.4;
eps=0.05;

// Variant switches.
// dry controls clock-mechanism-specific cassette geometry.
// wet controls water-reveal-specific cassette geometry.
dry = true;
wet = false;

// false = current proven reservoir-stand / side-diffuser wet cassette
// true  = hydraulic chimney, silicone snap-lock plug seat, restored low hitch,
//         and only the approved raised redirect / guide / upper cleat features
chimney = false;

// Optional dry-cassette access for reaching the internal string from outside
// with a small hooked tool such as a bent paper clip.
dry_external_string_access_slit = true;

// Wet-system experiment selector. Only one lower receiver should be active.
wet_use_legacy_bucket = false;
wet_use_integrated_pva_receiver = true;
// Direct horizontal-PVA architecture. Select exactly one diffuser branch.
// The established 7-inch/200 mm-class branch is preserved unchanged behind
// its switch. The active 80 mm trial replaces only its diffuser handling.
wet_use_7inch_diffuser = false;
wet_use_80mm_side_diffuser = true;
// Route the wet support string through the experimental latch's top eyelets.
// false restores the earlier low fork and shared right-side guide exactly.
// true raises the fork and adds a separate wet guide directly above the dry
// guide on the same wall; the unchanged dry guide can remain present too.
wet_use_top_eyelet_latch_path = true;
wet_use_reservoir_stand_wick = !chimney;

assert(!(wet_use_7inch_diffuser && wet_use_80mm_side_diffuser),
       "Select either the 7-inch diffuser or the 80 mm side diffuser, not both");
assert(chimney || wet_use_7inch_diffuser || wet_use_80mm_side_diffuser,
       "chimney=false requires one current diffuser branch");

// Legacy dry-cassette presentation switch. The dot-pull branch keeps this
// false: the front skin stays closed while the internal side-winding passage
// through the gusset and clock outline remains present.
front_clock_cutout = false;

// Print support switch.
// true  = include temporary floor-down print-support/scaffolding geometry.
// false = omit all removable crossbars, branches, posts, and contacts.
print_supports = true;

