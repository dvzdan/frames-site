clock_left_access_cut_h_z =
    clock_body_side * 0.35 + 1.0;   // 1 mm taller

clock_left_access_cut_z0 =
    clock_left_access_cut_z_center - clock_left_access_cut_h_z/2 - eps;

clock_left_access_cut_z1 =
