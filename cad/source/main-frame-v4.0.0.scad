module removable_roof_retainer_review(front_pair=true){
    roof_shift_y = front_pair ? 10 : -10;
    roof_shift_z = 4;
    review_y0 = front_pair
        ? removable_roof_y0-1
        : removable_roof_y1-14;
    review_y1 = front_pair
        ? roof_joint_core_y0+14
        : removable_roof_y1+1;
    review_z0 = roof_joint_side_lower_wedge_bottom_z-2;
    review_z1 = removable_roof_z1+roof_shift_z+2;

    color([0.62, 0.64, 0.67]) intersection(){
        cassette_body();
        translate([-1, review_y0, review_z0])
            cube([
                wall_w+2,
                review_y1-review_y0,
                review_z1-review_z0
            ]);
    }
    color([1.00, 0.55, 0.08]) intersection(){
        removable_roof_corner_slots();
        translate([-1, review_y0, review_z0])
            cube([
                wall_w+2,
                review_y1-review_y0,
                review_z1-review_z0
            ]);
    }
    color([0.12, 0.48, 0.92]) intersection(){
        translate([0, roof_shift_y, roof_shift_z])
            removable_roof_panel();
        translate([-1, review_y0, review_z0])
            cube([
                wall_w+2,
                review_y1-review_y0,
                review_z1-review_z0
            ]);
    }
}

