clock_stop_rect_h = 28.0;
clock_stop_roof_h = 23.0;

// NEUTRAL despite clock-ish name: shared clock-side structural pillar. Keep a
// Y-sloped top so descending paper sees a ramp, but omit the old widened foot,
// X-tapered upper flare, and rear-running toe. It is a true floor-rooted
// stalagmite with clearance from both Y walls. The pillar has one constant X
// section, with only the plain rectangular clock/seatbelt recess dry-gated.
module right_clock_stop_floor_gusset(){
    difference(){
        gusset_end_border_y = 2.0;
        gusset_front_y = clock_bar_trap_y0 - gusset_end_border_y;
        gusset_back_y = clock_bar_trap_y1 + gusset_end_border_y;
        gusset_block_x = 3.0;
        x1 = clock_side_gusset_x1;
        x0 = x1 - gusset_block_x;
        z0 = 0;
        z_back = z0 + clock_stop_rect_h;
        z_front = z_back + clock_stop_roof_h;
        // Remove most of the tall -Y spear while retaining a short final rise
        // above the rectangular portion, so paper still sees a low guiding
        // slope rather than a square obstruction. This places the horizontal
        // cap approximately at the user's marked red line.
        front_tip_remaining_rise_z = 4.5;
        front_tip_clip_z =
            clock_stop_roof_h - front_tip_remaining_rise_z;

        intersection(){
            sloped_wall_prism_x(
                [[gusset_front_y, z0],
                 [gusset_back_y, z0],
                 [gusset_back_y, z_back],
                 [gusset_front_y, z_front]],
                x0,
                x1);
            translate([x0-eps, gusset_front_y-eps, z0-eps])
                cube([
                    x1-x0+2*eps,
                    gusset_back_y-gusset_front_y+2*eps,
                    z_front-front_tip_clip_z-z0+eps
                ]);
        }

        // DRY-ONLY: square recess with no legacy ramp/detent geometry.
        if(dry)
            translate([
                clock_side_gusset_x1 - clock_bar_trap_depth_x,
                clock_bar_trap_y0,
                clock_bar_trap_z0
            ])
                cube([
                    clock_bar_trap_depth_x2 + eps,
                    clock_bar_trap_y1 - clock_bar_trap_y0,
                    clock_bar_trap_h_z
                ]);
    }
}

clock_backstop_inset_each_side = 6.0;
clock_backstop_ring_w = 2.0;
// The clock snaps cleanly into/out of this ring without the former 7 mm Y
// engagement. Retain 60% of that depth (4.2 mm total) and leave its surrounding
// print/structural supports unchanged.
clock_backstop_y_extra = 1.2;
// Local relief in the bottom rail for the battery-isolator pull string.
// Adjust this single knob if the opening needs a little more/less hand room.
clock_backstop_pull_notch_w_x = 8.0;

// NEUTRAL despite clock-ish name: shared rear/side structural gusset.
module right_clock_stop_rear_corner_gusset(){
    rear_corner_x_w    = 2.2;
    rear_corner_rise_z = 28.0;

    rear_corner_end_cliff_z = 2.0;

    y0 = bottom_front_shelf_y0;
    y1 = bottom_d+1;

    x1 = clock_side_gusset_x1;
    x0 = x1 - rear_corner_x_w;

    z0 = 1.8;
    z1 = bottom_t + rear_corner_rise_z;

    sloped_wall_prism_x(
        [[y0, z1],
         [y0, z0],
         [y1, z0],
         [y1, z0 + rear_corner_end_cliff_z]],
        x0, x1);
}

clock_backstop_top_y_ramp_drop = 2.0;

module clock_negative_y_backstop_ring(){
    outer_x0 = cutout_x + clock_backstop_inset_each_side;
    outer_x1 = cutout_x + clock_body_side - clock_backstop_inset_each_side;
    outer_z0 = clock_body_z0 + clock_backstop_inset_each_side;
    outer_z1 = clock_body_z1 - clock_backstop_inset_each_side - 1.8;
    inner_x0 = outer_x0 + clock_backstop_ring_w;
    inner_x1 = outer_x1 - clock_backstop_ring_w;
    inner_z0 = outer_z0 + clock_backstop_ring_w;
    inner_z1 = outer_z1 - clock_backstop_ring_w;
    y0 = bottom_front_shelf_y0;
    y1 = bottom_front_shelf_y1 + clock_backstop_y_extra;
    module ramped_rect(x0, x1, z0, z1){
        polyhedron(
            points=[[x0,y0,z0],[x1,y0,z0],[x1,y1,z0],[x0,y1,z0],[x0,y0,z1],[x1,y0,z1],[x1,y1,z1-clock_backstop_top_y_ramp_drop],[x0,y1,z1-clock_backstop_top_y_ramp_drop]],
            faces=[[0,1,2,3],[4,7,6,5],[0,4,5,1],[1,5,6,2],[2,6,7,3],[3,7,4,0]]);
    }
    difference(){
        ramped_rect(outer_x0, outer_x1, outer_z0, outer_z1);
        translate([inner_x0, y0-eps, inner_z0])
            cube([inner_x1-inner_x0, y1-y0+2*eps, inner_z1-inner_z0]);

        // Open only the bottom rail around the dot/pull-string path. The cut
        // spans the ring's full Y projection but preserves all other rails.
        translate([
            battery_pull_hole_x - clock_backstop_pull_notch_w_x/2,
            y0 - eps,
            outer_z0 - eps
        ])
            cube([
                clock_backstop_pull_notch_w_x,
                y1 - y0 + 2*eps,
                clock_backstop_ring_w + 2*eps
            ]);
    }
}

// Shared X/Z envelope for the clock winding finger path and optional front opening.
