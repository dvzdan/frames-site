spring_coil_hook_outer_d = 7.0;
spring_coil_hook_inner_d = 3.2;
spring_coil_hook_t_x     = 2.2;
spring_coil_hook_slit_w  = 1.0;

module left_spring_coil_hook(){
    hook_x = 4;
    hook_y = bottom_d - 22.0;
    hook_z = fang_main_z0 - 6.0;

    translate([hook_x, hook_y, hook_z])
        rotate([90,20,0])
            difference(){
                cylinder(d=spring_coil_hook_outer_d, h=spring_coil_hook_t_x, center=false);

                translate([0,0,-eps])
                    cylinder(d=spring_coil_hook_inner_d, h=spring_coil_hook_t_x + 2*eps, center=false);

                // slit through lower-left of the Y/Z ring profile
                translate([
                    -spring_coil_hook_slit_w/2,
                    -spring_coil_hook_outer_d/2 - eps,
                    -eps
                ])
                    cube([
                        spring_coil_hook_slit_w,
                        spring_coil_hook_outer_d/2 + eps,
                        spring_coil_hook_t_x + 2*eps
                    ]);
            
            }
}
guide_y_back  = wall_offset;
guide_y_front = acrylic_inner_y1;
guide_y0 = min(guide_y_back, guide_y_front);
guide_y1 = max(guide_y_back, guide_y_front);
left_guide_x0  = rear_guard_x0;
left_guide_x1  = rear_guard_x0 + rear_guard_border_x;
right_guide_x0 = rear_guard_x1 - rear_guard_border_x;
right_guide_x1 = rear_guard_x1;
guide_seg_z0 = view_z0 + view_h/2 - 4;
guide_seg_z1 = guide_seg_z0 + 8;
half_oval_steps = 48;

module left_half_oval_xy(x0, x1, y0, y1, steps=half_oval_steps){
    w=x1-x0; h=y1-y0; cy=(y0+y1)/2; ry=h/2;
    pts=concat([[x1,y0],[x1,y1]],[for(i=[0:steps])let(t=90+180*i/steps,xr=cos(t),yr=sin(t))[x0+w*(1+xr),cy+ry*yr]]);
    polygon(points=pts);
}

module right_half_oval_xy(x0, x1, y0, y1, steps=half_oval_steps){
    w=x1-x0; h=y1-y0; cy=(y0+y1)/2; ry=h/2;
    pts=concat([[x0,y1],[x0,y0]],[for(i=[0:steps])let(t=-90+180*i/steps,xr=cos(t),yr=sin(t))[x1-w*(1-xr),cy+ry*yr]]);
    polygon(points=pts);
}

module left_side_channel_block(z0=guide_seg_z0, z1=guide_seg_z1){
    difference(){
        translate([left_guide_x0, guide_y0, z0])
            cube([left_guide_x1-left_guide_x0, guide_y1-guide_y0, z1-z0]);
        translate([0, 0, z0-eps])
            linear_extrude(height=(z1-z0)+2*eps)
                left_half_oval_xy(left_guide_x0+channel_outer_x_clear, left_guide_x1+eps, guide_y0+channel_back_clear, guide_y1+eps);
    }
}

module right_side_channel_block(z0=guide_seg_z0, z1=guide_seg_z1){
    difference(){
        translate([right_guide_x0, guide_y0, z0])
            cube([right_guide_x1-right_guide_x0, guide_y1-guide_y0, z1-z0]);
        translate([0, 0, z0-eps])
            linear_extrude(height=(z1-z0)+2*eps)
                right_half_oval_xy(right_guide_x0-eps, right_guide_x1-channel_outer_x_clear, guide_y0+channel_back_clear, guide_y1+eps);
    }
}

// Independent floor-down void for the free -Y flange of the two tall
// half-channel blocks. The positive channel geometry remains exactly as it
// was; this negative volume simply supersedes anything it intersects. The +Y
// leg lies outside the void and therefore stays full-height and wall-rooted.
// A piecewise curve keeps every meaningful X run at roughly 45 degrees or
// steeper, then ends in a short sub-2 mm blunt land.
channel_front_relief_ds = [0, 4.0, 9.0, 13.5, 15.8, 17.0];
channel_front_relief_hs = [0, 4.8, 10.4, 15.2, 18.2, 18.2];

// Build the known-clean +X relief once. The -X relief below is a literal
// mirrored solid rather than a separately wound polygon.
module right_side_channel_front_relief_void(base_z=0,
                                            inner_x_overlap=0){
    n = len(channel_front_relief_ds);
    z_floor = base_z-1.0;
    root_x = right_guide_x1;
    end_x = root_x-channel_front_relief_ds[n-1]-inner_x_overlap;
    profile_points = concat(
        [[root_x,z_floor], [end_x,z_floor]],
        [for(i=[n-1:-1:0])
            [root_x-channel_front_relief_ds[i]
                -(i == 0 ? 0 : inner_x_overlap),
             base_z+channel_front_relief_hs[i]]]
    );
    // Cut through the unsupported front half of the C channel, ending at its
    // Y centerline. The rear half remains continuous with the cassette wall.
    channel_inner_front_y = guide_y0+channel_back_clear;
    channel_inner_back_y = guide_y1+eps;
    relief_y_inner = (channel_inner_front_y+channel_inner_back_y)/2+eps;
    relief_y_depth = relief_y_inner-(guide_y0-eps);

    translate([0,relief_y_inner,0])
        rotate([90,0,0])
            linear_extrude(height=relief_y_depth)
                polygon(points=profile_points);
}

module side_channel_front_relief_void(left_side=true, base_z=0){
    if(left_side)
        translate([left_guide_x0+right_guide_x1,0,0])
            mirror([1,0,0])
                right_side_channel_front_relief_void(base_z, 0.8);
    else
        right_side_channel_front_relief_void(base_z);
}

module side_channel_front_relief_voids(){
    relief_z0 =
        rear_guard_z0 - photo_hang_drop + channel_bottom_kill_z;
    side_channel_front_relief_void(true, relief_z0);
    side_channel_front_relief_void(false, relief_z0);
}

module left_side_channel_block_top_support(){
    z1 = perimeter_wall_top_z - 2.0;
    translate([left_guide_x0, guide_y0, z1])
        cube([channel_outer_x_clear, guide_y1-guide_y0, top_cross_z0-z1]);
}

module right_side_channel_block_top_support(){
    z1 = perimeter_wall_top_z - 2.0;
    translate([right_guide_x1 - channel_outer_x_clear, guide_y0, z1])
        cube([channel_outer_x_clear, guide_y1-guide_y0, top_cross_z0-z1]);
}

module side_channel_terminal_ramp(left_side=true, shelf_z0=0){
    if(left_side){
        ramp_run_x = left_guide_x0;
        triangular_prism_y(
            [[0, shelf_z0-ramp_run_x],
             [0, shelf_z0],
             [left_guide_x0, shelf_z0]],
            guide_y0,
            guide_y1);
    }
    else{
        ramp_run_x = wall_w-right_guide_x1;
        triangular_prism_y(
            [[wall_w, shelf_z0-ramp_run_x],
             [wall_w, shelf_z0],
             [right_guide_x1, shelf_z0]],
            guide_y0,
            guide_y1);
    }
}

channel_restored_top_z =
    rear_guard_z1+10.0;

assert(channel_restored_top_z
       > rear_guard_z0-photo_hang_drop+channel_bottom_kill_z,
       "restored channel cutoff removes the complete channel");
assert(channel_restored_top_z < removable_roof_z0,
       "restored channel cutoff intrudes into removable roof");
assert(channel_restored_top_z
       < roof_joint_front_lower_wedge_bottom_z,
       "channel cutoff leaves material in the roof-track approach space");

module restored_side_channels_clipped(){
    channel_z0 =
        rear_guard_z0-photo_hang_drop+channel_bottom_kill_z;

    difference(){
        union(){
            left_side_channel_block(
                channel_z0,
                perimeter_wall_top_z-2.0
            );
            right_side_channel_block(
                channel_z0,
                perimeter_wall_top_z-2.0
            );
            left_side_channel_block_top_support();
            right_side_channel_block_top_support();
            left_channel_flat_panel();
            right_channel_flat_panel();
        }

        // Pure subtraction at the user's red-line datum, 10 mm above the rear
        // wall. Nothing below this plane moves or changes shape; everything
        // belonging to this channel assembly above it is removed.
        translate([
            -1,
            true_full_y0-1,
            channel_restored_top_z
        ])
            cube([
                wall_w+2,
                true_full_y1-true_full_y0+2,
                shell_inner_top_z-channel_restored_top_z+2
            ]);
    }
}

module right_lower_channel_terminal_brace(){
    brace_h_z = 3.0;
    brace_base_z0 =
        rear_guard_z0 - photo_hang_drop + channel_bottom_kill_z;

    translate([right_guide_x1, guide_y0, brace_base_z0])
        cube([wall_w-right_guide_x1,
              guide_y1-guide_y0,
              brace_h_z]);

    side_channel_terminal_ramp(false, brace_base_z0);
}

module side_channel_terminal_side_braces(){
    brace_h_z = 3.0;

    brace_z0 =
        rear_guard_z0 - photo_hang_drop + channel_bottom_kill_z;

    brace_mid_z0 =
        brace_z0 + (shell_inner_top_z - brace_z0) / 2;

    // Each connector is a high horizontal shelf rooted at an outer X wall.
    // Its mirrored X/Z ramp grows inward from that wall in the floor-down
    // orientation while preserving the connector's bridge-breaking contact.
    translate([0, guide_y0, brace_z0])
        cube([left_guide_x0, guide_y1-guide_y0, brace_h_z]);
    side_channel_terminal_ramp(true, brace_z0);

    // Right lower connector now matches the other 3 mm shelves; its former
    // 8 mm downward extension was an asymmetric legacy workaround.
    right_lower_channel_terminal_brace();

    translate([0, guide_y0, brace_mid_z0])
        cube([left_guide_x0, guide_y1-guide_y0, brace_h_z]);
    side_channel_terminal_ramp(true, brace_mid_z0);

    translate([right_guide_x1, guide_y0, brace_mid_z0])
        cube([wall_w-right_guide_x1, guide_y1-guide_y0, brace_h_z]);
    side_channel_terminal_ramp(false, brace_mid_z0);
}

floor_bell_x = 0.6;
floor_bell_extra_z = 0.6;

module floor_bellbottoms(){
