// =========================================================
// OPTIONAL 80 MM SIDE DIFFUSER + MINIMAL FLEXIBLE-BOTTLE RETAINER
// =========================================================
// This branch deliberately does not reuse the discarded full sleeves, collars,
// bottom seat, vertical bottle spine, platform, or internal diffuser rails. The
// side bore locates the diffuser while one opposed pair of small cantilever arms
// relies on the bottle's own flexibility for light retention.
side_diffuser_80_d = 5.0;
side_diffuser_80_len = 80.0;
side_diffuser_80_clear_d = 0.6;
side_diffuser_80_angle_deg = 15;
side_diffuser_80_tip_x =
    reservoir_stand_wick_x+reservoir_stand_clip_offset_x;
side_diffuser_80_y = reservoir_stand_wick_floor_y;
side_diffuser_80_tip_z = horizontal_pva_z;

function side_diffuser_80_z_at_x(x) =
    side_diffuser_80_tip_z
    +(x-side_diffuser_80_tip_x)*tan(side_diffuser_80_angle_deg);

side_diffuser_80_r_clear =
    (side_diffuser_80_d+side_diffuser_80_clear_d)/2;

// Vertical stack, from the side port downward: rope hoop, 26 mm clear drop,
// drip basket, then the U/V hitch. Change extra_lowering_z only when the hitch
// should move still farther down; the basket remains anchored to the hoop.
side_diffuser_80_rope_hoop_clear_below_port_z = 8.0;
side_diffuser_80_rope_hoop_h_z = 4*wet_print_nozzle_d;
side_diffuser_80_basket_clear_below_hoop_z = 26.0;
side_diffuser_80_basket_h_z = 18.0;
side_diffuser_80_hitch_clear_below_basket_z = 8.0;
side_diffuser_80_hitch_extra_lowering_z = inch;
// Concealed interior U/V hitch directly below the diffuser bore. Rotate the
// approved free-jaw logic into the natural route here: a narrow Y-thick fin
// grows inward from the wall and presents a completely free +X tip. The PVA
// drops almost straight down, wraps around that tip, tensions in the lower U,
// then lifts into the upward V. Both fin faces stay accessible.
side_diffuser_80_hitch_jaw_t_y = 3*wet_print_nozzle_d;
side_diffuser_80_hitch_y0 =
    side_diffuser_80_y-side_diffuser_80_hitch_jaw_t_y/2;
side_diffuser_80_hitch_y1 =
    side_diffuser_80_y+side_diffuser_80_hitch_jaw_t_y/2;
side_diffuser_80_hitch_x0 = side_panel_t-eps;
side_diffuser_80_hitch_h_z = 10.0;
side_diffuser_80_hitch_bore_clear_z = 0.8;
// Primary hitch-placement controls. The derived lowering keeps the hitch below
// the basket; extra_lowering_z can add more clearance without moving the hoop
// or basket. Increase extension_x to move the U/V working area farther inward.
side_diffuser_80_hitch_lowering_z =
    side_diffuser_80_rope_hoop_clear_below_port_z
    +side_diffuser_80_rope_hoop_h_z
    +side_diffuser_80_basket_clear_below_hoop_z
    +side_diffuser_80_basket_h_z
    +side_diffuser_80_hitch_clear_below_basket_z
    -side_diffuser_80_hitch_bore_clear_z
    +side_diffuser_80_hitch_extra_lowering_z;
side_diffuser_80_hitch_extension_x = 12.9;
side_diffuser_80_hitch_z1 =
    side_diffuser_80_z_at_x(side_panel_t)
    -side_diffuser_80_r_clear
    -side_diffuser_80_hitch_bore_clear_z
    -side_diffuser_80_hitch_lowering_z;
side_diffuser_80_hitch_z0 =
    side_diffuser_80_hitch_z1-side_diffuser_80_hitch_h_z;
side_diffuser_80_hitch_v_mouth_w_x = 2.4;
side_diffuser_80_hitch_v_depth_z = 3.0;
side_diffuser_80_hitch_u_r = 1.0;
// Build one ordinary full-jaw-width support hull over the complete explicit
// 45-degree underside line, continuing to the actual free +X tip.
side_diffuser_80_hitch_support_web_fraction = 1.0;
// The tapered opening's hull anchor sits well above the outer triangle's low
// point, leaving the complete yellow support tip visible below the opening.
side_diffuser_80_hitch_hull_anchor_a_fraction = 0.32;
side_diffuser_80_hitch_hull_anchor_b_fraction = 0.44;
side_diffuser_80_hitch_hull_outer_web_t = 3*wet_print_nozzle_d;
// Keep a real two-line nose beyond the hitch cuts. Without this land the V's
// outer mouth point coincides with the free edge and degenerates visually and
// mechanically into a one-sided chamfer instead of an unmistakable V.
side_diffuser_80_hitch_free_tip_land_x = 2*wet_print_nozzle_d;
// Put the actual U/V working center one inch inward from the cassette wall.
// The printable shoulder and free-tip land extend beyond that datum.
side_diffuser_80_hitch_work_x =
    side_panel_t+side_diffuser_80_hitch_extension_x;
side_diffuser_80_hitch_x1 =
    side_diffuser_80_hitch_work_x
    +side_diffuser_80_hitch_free_tip_land_x
    +side_diffuser_80_hitch_v_mouth_w_x/2;
side_diffuser_80_hitch_web_embed_z = 0.2;
side_diffuser_80_hitch_web_root_x = side_diffuser_80_hitch_x0-eps;
side_diffuser_80_hitch_tip_support_x = side_diffuser_80_hitch_x1;
side_diffuser_80_hitch_tip_support_z =
    side_diffuser_80_hitch_z0-eps;
function side_diffuser_80_hitch_support_z_at_x(x) =
    side_diffuser_80_hitch_tip_support_z
    -(side_diffuser_80_hitch_tip_support_x-x);
side_diffuser_80_hitch_web_root_z =
    side_diffuser_80_hitch_support_z_at_x(
        side_diffuser_80_hitch_web_root_x
    );
side_diffuser_80_hitch_web_x1 =
    side_diffuser_80_hitch_web_root_x
    +side_diffuser_80_hitch_support_web_fraction
        *(side_diffuser_80_hitch_tip_support_x
          -side_diffuser_80_hitch_web_root_x);
side_diffuser_80_hitch_web_outer_lower_z =
    side_diffuser_80_hitch_support_z_at_x(
        side_diffuser_80_hitch_web_x1
    );

assert(!wet_use_80mm_side_diffuser
       || abs(side_diffuser_80_hitch_web_x1
              -side_diffuser_80_hitch_x1) < eps,
       "80 mm hitch support web does not reach the free tip");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_hitch_web_x1
            > side_diffuser_80_hitch_web_root_x,
       "80 mm hitch support web has no positive X run");

// Small vertical rope-guide hoop restored below the side port. Its clear bore
// matches the port, while a wall saddle holds the wet rope away from the wall.
side_diffuser_80_rope_hoop_id =
    side_diffuser_80_d+side_diffuser_80_clear_d;
side_diffuser_80_rope_hoop_wall = 3*wet_print_nozzle_d;
side_diffuser_80_rope_hoop_od =
    side_diffuser_80_rope_hoop_id+2*side_diffuser_80_rope_hoop_wall;
// Pull the guide as close to the inner wall as its ring thickness permits.
// The ring's outside edge is tangent to the wall; its existing saddle supplies
// the actual printable connection.
side_diffuser_80_rope_hoop_offset_x = side_diffuser_80_rope_hoop_od/2;
side_diffuser_80_rope_hoop_x =
    side_panel_t+side_diffuser_80_rope_hoop_offset_x;
side_diffuser_80_rope_hoop_y = side_diffuser_80_y;
// Keep the former level hoop datum for downstream basket placement.  The
// pitched hoop itself starts lower at the wall so its far/high edge does not
// consume any of the established diffuser-port clearance.
side_diffuser_80_rope_hoop_pitch_rise_per_x = 0.25;
side_diffuser_80_rope_hoop_pitch_root_x = side_panel_t;
side_diffuser_80_rope_hoop_pitch_max_rise_z =
    side_diffuser_80_rope_hoop_pitch_rise_per_x
    *((side_diffuser_80_rope_hoop_x+side_diffuser_80_rope_hoop_od/2)
      -side_diffuser_80_rope_hoop_pitch_root_x);
side_diffuser_80_rope_hoop_level_z0 =
    side_diffuser_80_z_at_x(side_panel_t)
    -side_diffuser_80_r_clear
    -side_diffuser_80_rope_hoop_clear_below_port_z
    -side_diffuser_80_rope_hoop_h_z;
side_diffuser_80_rope_hoop_z0 =
    side_diffuser_80_rope_hoop_level_z0
    -side_diffuser_80_rope_hoop_pitch_max_rise_z;
side_diffuser_80_rope_hoop_z1 =
    side_diffuser_80_rope_hoop_z0+side_diffuser_80_rope_hoop_h_z;
side_diffuser_80_rope_hoop_bridge_x0 = side_panel_t-eps;
side_diffuser_80_rope_hoop_bridge_x1 = side_diffuser_80_rope_hoop_x;
side_diffuser_80_rope_hoop_support_t_y = 2*wet_print_nozzle_d;
side_diffuser_80_rope_hoop_support_embed_z = 0.2;
side_diffuser_80_rope_hoop_ring_mid_r =
    (side_diffuser_80_rope_hoop_id+side_diffuser_80_rope_hoop_od)/4;
// Open only the free +X tip. The radial slot begins at the clear-bore tangent,
// leaving two full-height arms that nearly meet and allowing the wick to be
// pressed sideways into the existing bore.
side_diffuser_80_rope_hoop_side_load_gap_y = 3*wet_print_nozzle_d;
side_diffuser_80_rope_hoop_side_load_cut_x0 =
    side_diffuser_80_rope_hoop_x+side_diffuser_80_rope_hoop_id/2-eps;
side_diffuser_80_rope_hoop_side_load_cut_x1 =
    side_diffuser_80_rope_hoop_x+side_diffuser_80_rope_hoop_od/2+eps;

assert(!wet_use_80mm_side_diffuser
       || abs(side_diffuser_80_rope_hoop_id
              -(side_diffuser_80_d+side_diffuser_80_clear_d)) < eps,
       "80 mm rope hoop no longer matches the side-port bore");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_rope_hoop_ring_mid_r
            -side_diffuser_80_rope_hoop_support_t_y/2
            >= side_diffuser_80_rope_hoop_id/2,
       "80 mm rope-hoop support enters the clear bore");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_rope_hoop_side_load_gap_y
            < side_diffuser_80_rope_hoop_id,
       "80 mm rope-hoop side-load gap removes the retaining arms");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_rope_hoop_z1
            +side_diffuser_80_rope_hoop_pitch_max_rise_z
            <= side_diffuser_80_z_at_x(side_panel_t)
               -side_diffuser_80_r_clear
               -side_diffuser_80_rope_hoop_clear_below_port_z+eps,
       "80 mm rope hoop crowds the side port");

// Open drip basket with its shortened top 26 mm below the hoop. Its center and thin-string
// outlet remain at the former 8 mm depth while the wick hoop sits close to the
// wall, deliberately offsetting the drip from the string. The cassette wall
// itself closes the rear of the basket; no duplicate basket wall is needed.
// The floor itself rises at a printable 1:1 slope, so no underside support
// webs are needed.
side_diffuser_80_basket_wall = 3*wet_print_nozzle_d;
side_diffuser_80_basket_floor = 4*wet_print_nozzle_d;
// The thick plant wick stops above and drips into the basket. Only the thin
// reveal string passes through this floor opening; 2.4 mm leaves practical
// printed clearance without letting the absorbent filler escape easily.
side_diffuser_80_basket_drain_d = 2.4;
side_diffuser_80_basket_drain_chamfer_h = 0.8;
side_diffuser_80_basket_drain_mouth_d =
    side_diffuser_80_basket_drain_d
    +2*side_diffuser_80_basket_drain_chamfer_h;
side_diffuser_80_basket_x = side_panel_t+8.0;
side_diffuser_80_basket_x0 = side_panel_t-eps;
side_diffuser_80_basket_x1 =
    2*side_diffuser_80_basket_x-side_diffuser_80_basket_x0;
side_diffuser_80_basket_w_y = 18.0;
side_diffuser_80_basket_y0 =
    side_diffuser_80_rope_hoop_y-side_diffuser_80_basket_w_y/2;
side_diffuser_80_basket_y1 =
    side_diffuser_80_rope_hoop_y+side_diffuser_80_basket_w_y/2;
side_diffuser_80_basket_z1 =
    side_diffuser_80_rope_hoop_level_z0
    -side_diffuser_80_basket_clear_below_hoop_z;
side_diffuser_80_basket_z0 =
    side_diffuser_80_basket_z1-side_diffuser_80_basket_h_z;
// Start at the wall-side green-line edge and rise at a printable near-45-degree
// slope as the basket projects outward. Both faces follow the same pitch,
// producing one floor instead of a shallow bridge plus separate gussets.
side_diffuser_80_basket_pitch_rise_per_x = 0.95;
function side_diffuser_80_basket_bottom_z_at_x(x) =
    side_diffuser_80_basket_z0
    +side_diffuser_80_basket_pitch_rise_per_x
        *(x-side_diffuser_80_basket_x0);

assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_basket_drain_d
            < min(
                side_diffuser_80_basket_x1-side_diffuser_80_basket_x0
                    -2*side_diffuser_80_basket_wall,
                side_diffuser_80_basket_w_y
                    -2*side_diffuser_80_basket_wall
            ),
       "80 mm drip-basket drain leaves no surrounding floor");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_basket_bottom_z_at_x(
              side_diffuser_80_basket_x1
          )+side_diffuser_80_basket_floor
            <= side_diffuser_80_basket_z1+eps,
       "80 mm basket sloped floor overruns the shortened top");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_hitch_z1
            <= side_diffuser_80_basket_z0
               -side_diffuser_80_hitch_clear_below_basket_z+eps,
       "80 mm hitch is not fully below the drip basket");

// The bottle dimensions locate the open restraint hoop, bottom support tab,
// and the available
// diffuser dip. No bottle shape is emitted. The open mouth remains below the
// straight diffuser axis, allowing the real stick to make its gentle bend.
side_bottle_80_body_d = 23.0;
// The bottle sits one radial-clearance allowance from the wall. Consequently
// the hoop bore ends exactly at X=0 and the cassette wall replaces the entire
// rear-center segment of the hoop.
side_bottle_80_wall_gap_x = 0.3;
side_bottle_80_x =
    -(side_bottle_80_body_d/2+side_bottle_80_wall_gap_x);
side_bottle_80_mouth_drop_z = 8.0;
side_bottle_80_mouth_z =
    side_diffuser_80_z_at_x(side_bottle_80_x)
    -side_bottle_80_mouth_drop_z;

// A fully closed hoop prevents lateral escape. It loads vertically and rises
// gradually as it projects away from the cassette wall: the wall-side root
// stays low, while only the increasingly remote portions climb. A 1:2 rise
// gives the underside a printable stepped slope without lifting the diffuser-
// side root unnecessarily.
side_bottle_80_hoop_inner_d = side_bottle_80_body_d+0.6;
// Six nozzle lines make the wall-facing outer arc overlap the wall by 0.9 mm.
// That lets the hoop itself grow directly from the flat wall, with no separate
// bridge or underside web.
side_bottle_80_hoop_radial_t = 6*wet_print_nozzle_d;
side_bottle_80_hoop_outer_d =
    side_bottle_80_hoop_inner_d+2*side_bottle_80_hoop_radial_t;
side_bottle_80_arm_h_z = 8*wet_print_nozzle_d;
side_bottle_80_arm_drop_z = 28.0;
side_bottle_80_arm_z0 =
    side_bottle_80_mouth_z-side_bottle_80_arm_drop_z;
side_bottle_80_hoop_pitch_rise_per_x = 0.5;
// Remove the remote end of the hoop at 65% of the bore radius. This produces
// an approximately 18 mm mouth around the 23 mm bottle.
side_bottle_80_hoop_cut_fraction = 0.65;
side_bottle_80_hoop_wall_overlap_x =
    side_bottle_80_x+side_bottle_80_hoop_outer_d/2;

// A small shelf under the wall-side edge of the bottle carries the vertical
// load. It deliberately reaches only 5 mm beneath the body rather than becoming
// a large platform. A complete 45-degree web makes the shelf printable in the
// established floor-down orientation.
side_bottle_80_bottom_tab_underlap_x = 5.0;
side_bottle_80_bottom_tab_x0 =
    side_bottle_80_x+side_bottle_80_body_d/2
    -side_bottle_80_bottom_tab_underlap_x;
side_bottle_80_bottom_tab_x1 = side_panel_t+eps;
side_bottle_80_bottom_tab_w_y = 10.0;
side_bottle_80_bottom_tab_y0 =
    side_diffuser_80_y-side_bottle_80_bottom_tab_w_y/2;
side_bottle_80_bottom_tab_y1 =
    side_diffuser_80_y+side_bottle_80_bottom_tab_w_y/2;
side_bottle_80_bottom_tab_t_z = 4*wet_print_nozzle_d;
side_bottle_80_bottom_tab_drop_z = 17.0;
side_bottle_80_bottom_tab_z1 =
    side_bottle_80_arm_z0-side_bottle_80_bottom_tab_drop_z;
side_bottle_80_bottom_tab_z0 =
    side_bottle_80_bottom_tab_z1-side_bottle_80_bottom_tab_t_z;
side_bottle_80_bottom_tab_web_run_x =
    side_bottle_80_bottom_tab_x1-side_bottle_80_bottom_tab_x0;

side_diffuser_80_dry_path =
    (side_diffuser_80_tip_x-side_bottle_80_x)
        /cos(side_diffuser_80_angle_deg)
    +side_bottle_80_mouth_drop_z;
side_diffuser_80_dip_available =
    side_diffuser_80_len-side_diffuser_80_dry_path;

assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_dip_available >= 20.0,
       "80 mm diffuser leaves less than 20 mm available inside the bottle");
assert(!wet_use_80mm_side_diffuser
       || side_bottle_80_hoop_wall_overlap_x >= wet_print_nozzle_d-eps,
       "bottle hoop does not overlap the cassette wall by one nozzle line");
assert(!wet_use_80mm_side_diffuser
       || side_bottle_80_bottom_tab_x0
            <= side_bottle_80_x+side_bottle_80_body_d/2
               -side_bottle_80_bottom_tab_underlap_x+eps,
       "bottle bottom tab does not reach beneath the body");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_hitch_x1-side_diffuser_80_hitch_x0 >= 6.0,
       "80 mm diffuser hitch has too little wrap-fin projection");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_hitch_v_depth_z
            +2*side_diffuser_80_hitch_u_r
            < side_diffuser_80_hitch_h_z-2*wet_print_nozzle_d,
       "80 mm diffuser U/V hitch leaves too little center web");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_hitch_jaw_t_y >= 3*wet_print_nozzle_d-eps,
       "80 mm diffuser hitch jaw is fewer than three nozzle lines thick");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_hitch_free_tip_land_x
            >= 2*wet_print_nozzle_d-eps,
       "80 mm diffuser hitch V lost its printable outer shoulder");
assert(!wet_use_80mm_side_diffuser
       || side_diffuser_80_hitch_z1
            <= side_diffuser_80_z_at_x(side_panel_t)
               -side_diffuser_80_r_clear
               -side_diffuser_80_hitch_bore_clear_z+eps,
       "80 mm diffuser hitch is not fully below the side bore");

module side_diffuser_80_axis_cylinder(x0,x1,d){
    translate([x0,side_diffuser_80_y,side_diffuser_80_z_at_x(x0)])
        rotate([0,90-side_diffuser_80_angle_deg,0])
            cylinder(
                d=d,
                h=(x1-x0)/cos(side_diffuser_80_angle_deg),
                $fn=32
            );
}

module side_diffuser_80_wall_bore(){
    side_diffuser_80_axis_cylinder(
        -2.0,
        side_panel_t+2.0,
        side_diffuser_80_d+side_diffuser_80_clear_d
    );
}

module side_diffuser_80_hitch_rectangle_shape(){
    translate([
        side_diffuser_80_hitch_x0,
        side_diffuser_80_hitch_y0,
        side_diffuser_80_hitch_z0
    ])
        cube([
            side_diffuser_80_hitch_x1-side_diffuser_80_hitch_x0,
            side_diffuser_80_hitch_y1-side_diffuser_80_hitch_y0,
            side_diffuser_80_hitch_z1-side_diffuser_80_hitch_z0
        ]);
}

module side_diffuser_80_hitch_half_circle_void_shape(){
    xc = side_diffuser_80_hitch_work_x;
    y0 = side_diffuser_80_hitch_y0;
    y1 = side_diffuser_80_hitch_y1;
    z0 = side_diffuser_80_hitch_z0;
    r = side_diffuser_80_hitch_u_r;

    // Exactly the upper half of a through-cylinder: its diameter lies on the
    // rectangle's bottom edge and its arc rises into the jaw.
    intersection(){
        translate([xc,y0-eps,z0])
            rotate([-90,0,0])
                cylinder(r=r,h=y1-y0+2*eps,$fn=32);
        translate([xc-r-eps,y0-2*eps,z0])
            cube([2*r+2*eps,y1-y0+4*eps,r+2*eps]);
    }
}

module side_diffuser_80_hitch_triangle_shape(){
    // One literal outer support triangle: wall-side vertical attachment,
    // rectangle-bottom attachment, and the full low support point.
    minimal_wet_chamber_xz_prism([
        [side_diffuser_80_hitch_web_root_x,
         side_diffuser_80_hitch_web_root_z],
        [side_diffuser_80_hitch_web_root_x,
         side_diffuser_80_hitch_z0
            +side_diffuser_80_hitch_web_embed_z],
        [side_diffuser_80_hitch_tip_support_x,
         side_diffuser_80_hitch_z0
            +side_diffuser_80_hitch_web_embed_z]
    ],
    side_diffuser_80_hitch_y0,
    side_diffuser_80_hitch_y1);
}

module side_diffuser_80_hitch_hull_void_shape(){
    xc = side_diffuser_80_hitch_work_x;
    z0 = side_diffuser_80_hitch_z0;
    r = side_diffuser_80_hitch_u_r;
    anchor_a_x =
        side_diffuser_80_hitch_web_root_x
        +side_diffuser_80_hitch_hull_anchor_a_fraction
            *(side_diffuser_80_hitch_tip_support_x
              -side_diffuser_80_hitch_web_root_x);
    anchor_b_x =
        side_diffuser_80_hitch_web_root_x
        +side_diffuser_80_hitch_hull_anchor_b_fraction
            *(side_diffuser_80_hitch_tip_support_x
              -side_diffuser_80_hitch_web_root_x);
    anchor_a_z =
        side_diffuser_80_hitch_support_z_at_x(anchor_a_x)
        +side_diffuser_80_hitch_hull_outer_web_t;
    anchor_b_z =
        side_diffuser_80_hitch_support_z_at_x(anchor_b_x)
        +side_diffuser_80_hitch_hull_outer_web_t;
    y0 = side_diffuser_80_hitch_y0;
    y1 = side_diffuser_80_hitch_y1;

    // One literal hull.  The upper seed is the half-circle's diameter.  Two
    // lower seeds sit above the triangle's low point at different X values,
    // leaving a short finite throat instead of a needle-point taper.
    hull(){
        translate([xc-r,y0-eps,z0-eps])
            cube([2*r,y1-y0+2*eps,eps]);
        translate([anchor_a_x-eps/2,y0-eps,anchor_a_z-eps/2])
            cube([eps,y1-y0+2*eps,eps]);
        translate([anchor_b_x-eps/2,y0-eps,anchor_b_z-eps/2])
            cube([eps,y1-y0+2*eps,eps]);
    }
}

module side_diffuser_80_hitch_top_v_void_shape(){
    x0 = side_diffuser_80_hitch_x0;
    x1 = side_diffuser_80_hitch_x1;
    y0 = side_diffuser_80_hitch_y0;
    y1 = side_diffuser_80_hitch_y1;
    z0 = side_diffuser_80_hitch_z0;
    z1 = side_diffuser_80_hitch_z1;
    xc = side_diffuser_80_hitch_work_x;

    // Existing upward-facing through-V: independent fifth shape.
    translate([0,y1+eps,0])
        rotate([90,0,0])
            linear_extrude(height=y1-y0+2*eps,convexity=4)
                polygon(points=[
                    [xc-side_diffuser_80_hitch_v_mouth_w_x/2,z1+eps],
                    [xc,z1-side_diffuser_80_hitch_v_depth_z],
                    [xc+side_diffuser_80_hitch_v_mouth_w_x/2,z1+eps]
                ]);
}

module side_diffuser_80_uv_hitch_voids(){
    union(){
        side_diffuser_80_hitch_half_circle_void_shape();
        side_diffuser_80_hitch_hull_void_shape();
        side_diffuser_80_hitch_top_v_void_shape();
    }
}

module side_diffuser_80_uv_hitch(){
    difference(){
        union(){
            side_diffuser_80_hitch_rectangle_shape();
            side_diffuser_80_hitch_triangle_shape();
        }
        side_diffuser_80_hitch_half_circle_void_shape();
        side_diffuser_80_hitch_hull_void_shape();
        side_diffuser_80_hitch_top_v_void_shape();
    }
}

// Wet top-eyelet hitch: retain the approved U/V working datums, but place the
// cuts inside a substantially larger triangular carrier rather than mirroring
// the small lower hitch body. Moving this copy toward the cassette front in Y
// clears the dry guide below.
wet_top_hitch_dry_guide_y0 = bottom_d-22.0;
wet_top_hitch_clear_from_dry_y = 2*wet_print_nozzle_d;
wet_top_hitch_y1 =
    wet_top_hitch_dry_guide_y0-wet_top_hitch_clear_from_dry_y;
wet_top_hitch_y =
    wet_top_hitch_y1-side_diffuser_80_hitch_jaw_t_y/2;
wet_top_hitch_z1 =
    wet_top_eyelet_thread_path_z+side_diffuser_80_hitch_v_depth_z;
wet_top_hitch_z0 = wet_top_hitch_z1-side_diffuser_80_hitch_h_z;
wet_top_hitch_translate_y = wet_top_hitch_y-side_diffuser_80_y;
wet_top_hitch_translate_z = wet_top_hitch_z0-side_diffuser_80_hitch_z0;

// A 1.65x linear carrier is about 2.7x the former triangular-web area. Its
// near-45-degree outer edge passes just below the lower U seat, embedding both
// working cuts in one broad printable web without moving either seat.
wet_top_hitch_carrier_linear_scale = 1.65;
wet_top_hitch_carrier_x0 = side_diffuser_80_hitch_x0;
wet_top_hitch_carrier_run_x =
    wet_top_hitch_carrier_linear_scale
    *(side_diffuser_80_hitch_x1-side_diffuser_80_hitch_x0);
wet_top_hitch_carrier_x1 =
    wet_top_hitch_carrier_x0+wet_top_hitch_carrier_run_x;
wet_top_hitch_carrier_top_extra_z = 2*wet_print_nozzle_d;
wet_top_hitch_carrier_top_z =
    side_diffuser_80_hitch_z1+wet_top_hitch_carrier_top_extra_z;
wet_top_hitch_carrier_bottom_z =
    wet_top_hitch_carrier_top_z-wet_top_hitch_carrier_run_x;
function wet_top_hitch_carrier_diagonal_z_at_x(x) =
    wet_top_hitch_carrier_bottom_z+(x-wet_top_hitch_carrier_x0);

// The upper V needs a straight access continuation through the carrier's new
// top land. The lower tapered U relief already reaches the enlarged diagonal.
wet_top_hitch_upper_access_w_x = side_diffuser_80_hitch_v_mouth_w_x;
wet_top_hitch_upper_access_x0 =
    side_diffuser_80_hitch_work_x-wet_top_hitch_upper_access_w_x/2;

// Full two-nozzle-line bridges. They are added only where the permanent voids
// cross these Z bands, so their exposed portions can be snipped away cleanly.
wet_top_hitch_sacrificial_rib_t_z = 2*wet_print_nozzle_d;
wet_top_hitch_upper_rib_z0 = side_diffuser_80_hitch_z1;
wet_top_hitch_lower_rib_z0 =
    side_diffuser_80_hitch_z0-4.8;

assert(!wet_use_top_eyelet_latch_path
       || wet_top_hitch_y1
            <= wet_top_hitch_dry_guide_y0
               -wet_top_hitch_clear_from_dry_y+eps,
       "wet mirrored hitch/support interferes with dry guide in Y");
assert(!wet_use_top_eyelet_latch_path
       || abs((wet_top_hitch_z1-side_diffuser_80_hitch_v_depth_z)
              -wet_top_eyelet_thread_path_z) < eps,
       "wet mirrored hitch V is not aligned with the top-eyelet thread path");
assert(!wet_use_top_eyelet_latch_path
       || wet_top_hitch_carrier_diagonal_z_at_x(
              side_diffuser_80_hitch_work_x
          )
            <= side_diffuser_80_hitch_z0
               -wet_print_nozzle_d-eps,
       "wet top hitch carrier leaves too little web below the lower U seat");

module wet_top_eyelet_mirrored_uv_hitch_transform(){
    translate([
        wall_w,
        wet_top_hitch_translate_y,
        wet_top_hitch_translate_z
    ])
        mirror([1,0,0])
            children();
}

module wet_top_hitch_carrier_local(){
    minimal_wet_chamber_xz_prism([
        [wet_top_hitch_carrier_x0,wet_top_hitch_carrier_bottom_z],
        [wet_top_hitch_carrier_x0,wet_top_hitch_carrier_top_z],
        [wet_top_hitch_carrier_x1,wet_top_hitch_carrier_top_z]
    ],
    side_diffuser_80_hitch_y0,
    side_diffuser_80_hitch_y1);
}

module wet_top_hitch_upper_access_void_local(){
    translate([
        wet_top_hitch_upper_access_x0,
        side_diffuser_80_hitch_y0-eps,
        side_diffuser_80_hitch_z1-eps
    ])
        cube([
            wet_top_hitch_upper_access_w_x,
            side_diffuser_80_hitch_y1-side_diffuser_80_hitch_y0+2*eps,
            wet_top_hitch_carrier_top_z-side_diffuser_80_hitch_z1+2*eps
        ]);
}

module wet_top_hitch_sacrificial_ribs_local(){
    intersection(){
        wet_top_hitch_carrier_local();
        union(){
            for(z0=[wet_top_hitch_lower_rib_z0,wet_top_hitch_upper_rib_z0])
                translate([
                    wet_top_hitch_carrier_x0-eps,
                    side_diffuser_80_hitch_y0-eps,
                    z0
                ])
                    cube([
                        wet_top_hitch_carrier_x1-wet_top_hitch_carrier_x0
                            +2*eps,
                        side_diffuser_80_hitch_y1-side_diffuser_80_hitch_y0
                            +2*eps,
                        wet_top_hitch_sacrificial_rib_t_z
                    ]);
        }
    }
}

module wet_top_hitch_permanent_voids_local(){
    union(){
        side_diffuser_80_uv_hitch_voids();
        wet_top_hitch_upper_access_void_local();
    }
}

module wet_top_hitch_print_voids_local(){
    // Preserve only the two deliberate breakaway bands inside the otherwise
    // continuous working voids, including during the cassette's final recut.
    difference(){
        wet_top_hitch_permanent_voids_local();
        wet_top_hitch_sacrificial_ribs_local();
    }
}

module wet_top_eyelet_mirrored_uv_hitch(){
    wet_top_eyelet_mirrored_uv_hitch_transform()
        difference(){
            wet_top_hitch_carrier_local();
            wet_top_hitch_print_voids_local();
        }
}

module wet_top_eyelet_mirrored_uv_hitch_voids(){
    wet_top_eyelet_mirrored_uv_hitch_transform()
        wet_top_hitch_print_voids_local();
}

module side_diffuser_80_rope_hoop_supports(){
    support_run_x =
        side_diffuser_80_rope_hoop_x-side_panel_t;

    // Two permanent 45-degree ribs meet the ring at its Y-side material,
    // safely outside the vertical rope bore and drip path.
    for(s=[-1,1]){
        support_yc =
            side_diffuser_80_rope_hoop_y
            +s*side_diffuser_80_rope_hoop_ring_mid_r;

        minimal_wet_chamber_xz_prism([
            [side_panel_t-eps,
             side_diffuser_80_rope_hoop_z0-support_run_x],
            [side_panel_t-eps,
             side_diffuser_80_rope_hoop_z0
                +side_diffuser_80_rope_hoop_support_embed_z],
            [side_diffuser_80_rope_hoop_x,
             side_diffuser_80_rope_hoop_z0
                +side_diffuser_80_rope_hoop_support_embed_z]
        ],
        support_yc-side_diffuser_80_rope_hoop_support_t_y/2,
        support_yc+side_diffuser_80_rope_hoop_support_t_y/2);
    }
}

module side_diffuser_80_rope_guide_hoop(){
    pitch = side_diffuser_80_rope_hoop_pitch_rise_per_x;
    root_x = side_diffuser_80_rope_hoop_pitch_root_x;

    // Shear the complete hoop, saddle, bore, and lower ribs together.  The
    // rope path remains vertical, while both annular faces rise with X and the
    // wall-side attachment stays exactly at its former Z.
    multmatrix([
        [1,0,0,0],
        [0,1,0,0],
        [pitch,0,1,-pitch*root_x],
        [0,0,0,1]
    ])
        union(){
            difference(){
                union(){
                    translate([
                        side_diffuser_80_rope_hoop_x,
                        side_diffuser_80_rope_hoop_y,
                        side_diffuser_80_rope_hoop_z0
                    ])
                        cylinder(
                            d=side_diffuser_80_rope_hoop_od,
                            h=side_diffuser_80_rope_hoop_h_z,
                            $fn=32
                        );

                    // Deep wall saddle: subtracting the bore after union leaves
                    // a broad U-shaped root rather than a fragile tangent.
                    translate([
                        side_diffuser_80_rope_hoop_bridge_x0,
                        side_diffuser_80_rope_hoop_y
                            -side_diffuser_80_rope_hoop_od/2,
                        side_diffuser_80_rope_hoop_z0
                    ])
                        cube([
                            side_diffuser_80_rope_hoop_bridge_x1
                                -side_diffuser_80_rope_hoop_bridge_x0,
                            side_diffuser_80_rope_hoop_od,
                            side_diffuser_80_rope_hoop_h_z
                        ]);
                }

                translate([
                    side_diffuser_80_rope_hoop_x,
                    side_diffuser_80_rope_hoop_y,
                    side_diffuser_80_rope_hoop_z0-eps
                ])
                    cylinder(
                        d=side_diffuser_80_rope_hoop_id,
                        h=side_diffuser_80_rope_hoop_h_z+2*eps,
                        $fn=32
                    );

                // Radial free-tip opening: the two remaining arc ends form the
                // nearly meeting side-load arms requested for the wet wick.
                translate([
                    side_diffuser_80_rope_hoop_side_load_cut_x0,
                    side_diffuser_80_rope_hoop_y
                        -side_diffuser_80_rope_hoop_side_load_gap_y/2,
                    side_diffuser_80_rope_hoop_z0-eps
                ])
                    cube([
                        side_diffuser_80_rope_hoop_side_load_cut_x1
                            -side_diffuser_80_rope_hoop_side_load_cut_x0,
                        side_diffuser_80_rope_hoop_side_load_gap_y,
                        side_diffuser_80_rope_hoop_h_z+2*eps
                    ]);
            }

            side_diffuser_80_rope_hoop_supports();
        }
}

module side_diffuser_80_basket_drain_cutter(){
    pitch = side_diffuser_80_basket_pitch_rise_per_x;
    tilt_y = -atan(pitch);
    normal_floor_t =
        side_diffuser_80_basket_floor/sqrt(1+pitch*pitch);
    drain_floor_z =
        side_diffuser_80_basket_bottom_z_at_x(side_diffuser_80_basket_x);

    // Follow the floor normal rather than world Z.  A vertical cutter only
    // fully opened one side after the floor was pitched, producing the clipped
    // semicircle seen in preview.  The throat and both lead-ins now share the
    // same perpendicular axis through the constant-thickness sloped floor.
    translate([
        side_diffuser_80_basket_x,
        side_diffuser_80_rope_hoop_y,
        drain_floor_z
    ])
        rotate([0,tilt_y,0])
            union(){
                translate([0,0,-eps])
                    cylinder(
                        d=side_diffuser_80_basket_drain_d,
                        h=normal_floor_t+2*eps,
                        $fn=32
                    );

                translate([0,0,-eps])
                    cylinder(
                        d1=side_diffuser_80_basket_drain_mouth_d,
                        d2=side_diffuser_80_basket_drain_d,
                        h=side_diffuser_80_basket_drain_chamfer_h+eps,
                        $fn=32
                    );

                translate([
                    0,
                    0,
                    normal_floor_t
                        -side_diffuser_80_basket_drain_chamfer_h
                ])
                    cylinder(
                        d1=side_diffuser_80_basket_drain_d,
                        d2=side_diffuser_80_basket_drain_mouth_d,
                        h=side_diffuser_80_basket_drain_chamfer_h+eps,
                        $fn=32
                    );
            }
}

module side_diffuser_80_drip_basket(){
    basket_y0 =
        side_diffuser_80_rope_hoop_y-side_diffuser_80_basket_w_y/2;
    floor_x0 = side_diffuser_80_basket_x0;
    floor_x1 = side_diffuser_80_basket_x1;
    floor_z0 = side_diffuser_80_basket_bottom_z_at_x(floor_x0);
    floor_z1 = side_diffuser_80_basket_bottom_z_at_x(floor_x1);

    difference(){
        union(){
                // Parallel sloped faces keep the floor thickness constant.
                hull(){
                    translate([floor_x0,basket_y0,floor_z0])
                        cube([eps,side_diffuser_80_basket_w_y,
                              side_diffuser_80_basket_floor]);
                    translate([floor_x1-eps,basket_y0,floor_z1])
                        cube([eps,side_diffuser_80_basket_w_y,
                              side_diffuser_80_basket_floor]);
                }

                // Two side walls follow the pitched lower edge. The cassette
                // wall still closes the rear, so no duplicate rear wall exists.
                for(y0=[
                    basket_y0,
                    basket_y0+side_diffuser_80_basket_w_y
                        -side_diffuser_80_basket_wall
                ])
                    minimal_wet_chamber_xz_prism([
                        [floor_x0,floor_z0],
                        [floor_x0,side_diffuser_80_basket_z1],
                        [floor_x1,side_diffuser_80_basket_z1],
                        [floor_x1,floor_z1]
                    ],y0,y0+side_diffuser_80_basket_wall);

                // Outboard retaining wall begins on the raised end of the
                // sloped floor.
                translate([
                    floor_x1-side_diffuser_80_basket_wall,
                    basket_y0,
                    floor_z1
                ]) cube([
                    side_diffuser_80_basket_wall,
                    side_diffuser_80_basket_w_y,
                    side_diffuser_80_basket_z1-floor_z1
                ]);
            }

            // Thin-string outlet with 0.8 mm 45-degree lead-ins on both faces.
            // The straight 2.4 mm throat remains, but neither printed floor
            // edge presents a sharp corner to a moving wet string.
            side_diffuser_80_basket_drain_cutter();
    }
}

module side_bottle_80_open_pitched_hoop(){
    // X=0 is the exterior wall face. The hoop is level exactly there and
    // rises only as it projects into negative X away from the cassette.
    root_reference_x = 0;
    pitch = side_bottle_80_hoop_pitch_rise_per_x;
    inner_r = side_bottle_80_hoop_inner_d/2;
    outer_r = side_bottle_80_hoop_outer_d/2;
    cut_dx = side_bottle_80_hoop_cut_fraction*inner_r;
    cap_x = side_bottle_80_x-cut_dx;
    cap_outer_y = sqrt(outer_r*outer_r-cut_dx*cut_dx);
    cap_inner_y = sqrt(inner_r*inner_r-cut_dx*cut_dx);
    cap_y = (cap_outer_y+cap_inner_y)/2;
    cap_r = (cap_outer_y-cap_inner_y)/2;
    clip_x0 = cap_x-cap_r-eps;
    clip_z0 = side_bottle_80_arm_z0-eps;
    clip_z_h = side_bottle_80_arm_h_z
        +pitch*(root_reference_x-clip_x0)+2*eps;

    // The oversized outer arc gives broad attachment bands on both sides of
    // the bottle. Clip it at the wall face so no rear-center hoop material is
    // visible or protrudes through the panel; EPS supplies a robust union.
    intersection(){
        multmatrix([
            [1,0,0,0],
            [0,1,0,0],
            [-pitch,0,1,pitch*root_reference_x],
            [0,0,0,1]
        ])
            union(){
                // Retain only the wall-side portion of the annulus.
                intersection(){
                    difference(){
                        translate([
                            side_bottle_80_x,
                            side_diffuser_80_y,
                            side_bottle_80_arm_z0
                        ])
                            cylinder(
                                d=side_bottle_80_hoop_outer_d,
                                h=side_bottle_80_arm_h_z
                            );

                        translate([
                            side_bottle_80_x,
                            side_diffuser_80_y,
                            side_bottle_80_arm_z0-eps
                        ])
                            cylinder(
                                d=side_bottle_80_hoop_inner_d,
                                h=side_bottle_80_arm_h_z+2*eps
                            );
                    }

                    translate([
                        cap_x,
                        side_diffuser_80_y-outer_r-eps,
                        side_bottle_80_arm_z0-eps
                    ])
                        cube([
                            side_bottle_80_hoop_outer_d,
                            side_bottle_80_hoop_outer_d+2*eps,
                            side_bottle_80_arm_h_z+2*eps
                        ]);
                }

                // Full-height round caps remove both sharp cut faces.
                for(side=[-1,1])
                    translate([
                        cap_x,
                        side_diffuser_80_y+side*cap_y,
                        side_bottle_80_arm_z0
                    ])
                        cylinder(r=cap_r,h=side_bottle_80_arm_h_z);
            }

        translate([
            clip_x0,
            side_diffuser_80_y-outer_r-eps,
            clip_z0
        ])
            cube([
                eps-clip_x0,
                side_bottle_80_hoop_outer_d+2*eps,
                clip_z_h
            ]);
    }
}

module side_bottle_80_bottom_tab(){
    translate([
        side_bottle_80_bottom_tab_x0,
        side_bottle_80_bottom_tab_y0,
        side_bottle_80_bottom_tab_z0
    ])
        cube([
            side_bottle_80_bottom_tab_x1-side_bottle_80_bottom_tab_x0,
            side_bottle_80_bottom_tab_y1-side_bottle_80_bottom_tab_y0,
            side_bottle_80_bottom_tab_t_z
        ]);

    // Complete 45-degree web beneath the tab; nothing begins over open air.
    translate([0,side_bottle_80_bottom_tab_y1+eps,0])
        rotate([90,0,0])
            linear_extrude(
                height=side_bottle_80_bottom_tab_w_y+2*eps,
                convexity=4
            )
                polygon(points=[
                    [side_bottle_80_bottom_tab_x1,
                     side_bottle_80_bottom_tab_z0
                        -side_bottle_80_bottom_tab_web_run_x],
                    [side_bottle_80_bottom_tab_x1,
                     side_bottle_80_bottom_tab_z0],
                    [side_bottle_80_bottom_tab_x0,
                     side_bottle_80_bottom_tab_z0]
                ]);
}

module side_bottle_80_cradle(){
    side_bottle_80_open_pitched_hoop();
    side_bottle_80_bottom_tab();
}
// =========================================================
// VARIANT FEATURE GROUPS
// =========================================================

module dry_variant_additive_features(){
    // DRY-ONLY: actual clock mechanism holder / release-side hardware.
    // The shortened top retainer ends flush with its horizontal plank and no
    // longer uses the former remote +Y underside gusset.
    clock_negative_y_backstop_ring();
    right_thread_hook();
}

module dry_variant_subtractive_features(){
    // DRY-ONLY: retain the internal side-winding passage. Besides finger
    // clearance, this removes the unneeded intersecting chunks of the gusset
    // and square clock-retainer outline. The front skin itself stays closed.
    clock_internal_finger_access_void();

    // The only through-access in the front skin is the small string bore
    // disguised as the period in the website label.
    battery_isolator_pull_bore();

    if(dry_external_string_access_slit)
        dry_external_string_access_slit_void();
}

module wet_variant_additive_features(){
    // WET-ONLY: water reveal hardware.
    if(wet_use_reservoir_stand_wick){
        if(wet_use_7inch_diffuser){
            reservoir_stand_roach_clip();
            reservoir_stand_wick_guide_hoop();
        }
        if(wet_use_80mm_side_diffuser){
            side_bottle_80_cradle();
            side_diffuser_80_rope_guide_hoop();
            side_diffuser_80_drip_basket();
            side_diffuser_80_uv_hitch();
        }
        horizontal_pva_raised_redirect();
        if(wet_use_top_eyelet_latch_path){
            // The restored guide is shared by dry and wet. In a wet-only
            // build, emit it here because the dry feature group is absent.
            if(!dry)
                right_thread_hook();
            right_thread_triangle_cleat_hitch();
        }
        else
            // Exact legacy wet path: reuse the dry guide in its original
            // position and orientation.
            right_thread_hook();
    }
    else{
        left_water_tank();
        if(wet_use_legacy_bucket){
            bucket_under_tank_tension_lips();
            bucket_retention_hook();
        }
        // A chimney build always includes its integrated hydraulic receiver;
        // the silicone plug seat and water transition depend on this solid.
        integrated_pva_receiver_solid();
        receiver_boot_edge_gussets();
        chimney_overflow_guard();

        // Keep only the explicitly requested modern routing features. The
        // complete 80 mm diffuser/basket/cradle package remains excluded by
        // wet_use_reservoir_stand_wick = !chimney above.
        horizontal_pva_raised_redirect();
        if(wet_use_top_eyelet_latch_path){
            // The shared guide is already emitted by the dry branch in the
            // normal combined cassette. Emit it here for a wet-only build.
            if(!dry)
                right_thread_hook();
            right_thread_triangle_cleat_hitch();
        }
        else if(!dry)
            right_thread_hook();

        // Preserve the proven original chimney hitch at its low location.
        wet_bottom_string_cleat();
    }

}

module wet_variant_subtractive_features(){
    if(wet_use_reservoir_stand_wick){
        if(wet_use_7inch_diffuser)
            reservoir_stand_wick_floor_hole();
        if(wet_use_80mm_side_diffuser){
            side_diffuser_80_wall_bore();
            // Repeat the hitch cutters at the cassette's final subtractive
            // stage so no overlapping additive body can refill the U or V.
            side_diffuser_80_uv_hitch_voids();
        }
        // The active top-eyelet hitch is now completely contained in the
        // resolved middle +X roller gusset; no separate final-stage recut.
    }
    else{
        // Complete chimney penetrations and hydraulic receiver cavity.
        reservoir_side_fill_bore();
        reservoir_roof_vent_bore();
        reservoir_wick_side_hole_bore();
        integrated_pva_receiver_water_voids();

        // Commercial silicone snap-lock plug system: accessible outside peel
        // pocket, 5.2 mm locking bore, and self-supporting wet-side funnel.
        integrated_receiver_bottom_drain();
        integrated_drain_access_recess();
    }

    // The current non-chimney wet cassette retains its simple open gravity
    // drain. The chimney branch above instead receives the full plug geometry.
    if(!chimney)
        wet_basic_bottom_drain();
}

// Retired floor-down swap partner retained only for design history. The active
// cassette again uses the original lower locator nub and upper capture lip.
module trap_rig_receiver_lower_left_bottom_lip(){
    if(trap_receiver_on && trap_lip_on){

        // bottom root strip
        translate([
            trap_rig_x1 - trap_lip_bottom_len_x,
            wall_offset,
            trap_buildout_wall_z0
        ])
            cube([
                trap_lip_bottom_len_x,
                trap_lip_y0 - wall_offset,
                trap_lip_root_t
            ]);

        // bottom capture leg only
        translate([
            trap_rig_x1 - trap_lip_bottom_len_x,
            trap_lip_y0,
            trap_buildout_wall_z0
        ])
            cube([
                trap_lip_bottom_len_x,
                trap_lip_y1 - trap_lip_y0,
                trap_lip_root_t + trap_lip_overlap
            ]);
    }
}

module cassette_body(include_trap_upper_right_receiver=true){
    union(){
        difference(){
            union(){
                // ---------- shared cassette body ----------
                bottom_panel();

                // Contains the dry clock tab plus the floor-down, upper-window
                // print_supports-gated scaffold/crossbar geometry.
                clock_movement_retainers();

                if(dry)
                    dry_variant_additive_features();

                rear_buildout_perimeter();
                // Thin but permanent: this remains fused in the printed frame.
                if(print_supports){
                    rear_receiver_print_arch();
                    rear_receiver_print_wedges();
                }
                trap_rig_receiver_grey_nubs();
                translate([
                    trap_lip_corner_x - trap_stop_w_x - trap_stop_clear + trap_right_stop_trim_left_x,
                    trap_right_stop_y0,
                    trap_buildout_wall_z0 + trap_lip_side_len_z - trap_right_stop_h_z + 3
                ])
                    cube([
                        trap_stop_w_x - trap_right_stop_trim_left_x,
                        trap_right_stop_y1 - trap_right_stop_y0,
                        trap_right_stop_h_z + trap_right_stop_extra_top_z
                    ]);
                trap_rig_receiver_lower_right_lip();
                trap_rig_receiver_upper_left_top_lip();
                if(print_supports){
                    trap_rig_receiver_upper_left_sacrificial_contact();
                    trap_rig_receiver_upper_left_outer_sacrificial_contact();
                }
                // The short roof-fit coupon does not exercise this trap-rig
                // receiver. Omitting it there removes the hanging stalactite;
                // all complete-cassette selectors retain the established part.
                if(include_trap_upper_right_receiver){
                    trap_rig_receiver_upper_right_lip();
                    if(print_supports){
                        trap_rig_receiver_upper_right_sacrificial_contact();
                        trap_rig_receiver_upper_right_side_tip_sacrificial_contact();
                    }
                }
                if(wet)
                    wet_variant_additive_features();

                left_side_panel();
                right_side_panel();
                side_backing_clips();
                lower_board_hooks();
                // The former removable floor fins supported the floor only in
                // the inverted build. The floor now begins on the build plate,
                // so those fins are intentionally absent.

                // NEUTRAL despite legacy clock-ish names: side/floor structural gussets.
                translate([112,0,0]) right_clock_stop_floor_gusset();
                // The former long rear-corner toe belonged to the old tapered
                // gusset and is intentionally omitted in the floor-down block.

                // EXPERIMENTAL: the former integral roof is now a separate
                // removable body. The validated continuous three-sided track,
                // chamfer supports, span breakers, and front detent stay with
                // the cassette.
                removable_roof_corner_slots();

               /* // Left-side mirrored thread hook raised to sit just below the roller receiver/cutout.
                left_thread_hook_raise_z = (roller_receiver_cz - roller_receiver_outer_r - 3.0) - (fang_main_z0 - 6.0);
                translate([wall_w, -3, left_thread_hook_raise_z])
                    mirror([1, 0, 0])
                        right_thread_hook();*/
                        //left_spring_coil_hook();
                //left_thread_string_tube();
                // The complete backing-board roof retainers now belong to
                // removable_roof_panel(), not the roofless cassette body.
                front_buildout_parts();
                // Local rear reinforcement under the debossed URL.
                front_website_backing();
            }
            // Restore the proven printability relief through only the free
            // -Y skins of the two tall half-channels. The positive channel
            // and connector geometry remains untouched; the wall-rooted rear
            // half stays continuous.
            side_channel_front_relief_voids();
            // NEUTRAL: shallow molded-style recess across the bottom front.
            front_website_deboss();
            if(dry)
                dry_variant_subtractive_features();
            //left_thread_string_tube_void();
            if(wet)
                wet_variant_subtractive_features();
        }

        // DRY-ONLY optional print support; intentionally remains off to preserve current render.
        // if(dry) clock_void_front_x_bar();
    }
}
